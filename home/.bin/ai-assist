        return f"You have {count} unread emails. Recent ones include: {', '.join(details)}."
    except Exception as e:
        return f"email details unavailable: {e}"

def perform_web_search(query: str) -> str:
    """Fetch live web snippets using DuckDuckGo search with a safety timeout."""
    def _search():
        with DDGS() as ddgs:
            return [r.get('body', '') for r in ddgs.text(query, max_results=3)]
    try:
        print("Searching the web...")
        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:
            future = executor.submit(_search)
            results = future.result(timeout=4)
            return "\n".join(results) if results else "No relevant web results found."
    except Exception:
        return "Web search unavailable."

def perform_wikipedia_search(query: str) -> str:
    """Fetch encyclopedic summaries directly from Wikipedia API."""
    try:
        encoded_query = urllib.parse.quote(query)
        url = f"https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch={encoded_query}&format=json&srlimit=1"
        req = urllib.request.Request(url, headers={'User-Agent': 'AIAssistant/1.0'})
        with urllib.request.urlopen(req, timeout=3) as response:
            data = json.loads(response.read().decode())
            search_results = data.get("query", {}).get("search", [])
            if search_results:
                title = search_results[0]["title"]
                summary_url = f"https://en.wikipedia.org/api/rest_v1/page/summary/{urllib.parse.quote(title)}"
                sum_req = urllib.request.Request(summary_url, headers={'User-Agent': 'AIAssistant/1.0'})
                with urllib.request.urlopen(sum_req, timeout=3) as sum_response:
                    sum_data = json.loads(sum_response.read().decode())
                    extract = sum_data.get("extract", "")
                    if extract:
                        return f"{extract}"
        return "No relevant Wikipedia entry found."
    except Exception:
        return "Wikipedia search unavailable."

def safe_ollama_chat(model, messages, tools=None, options=None, timeout=12):
    """Executes ollama.chat with a thread timeout to prevent infinite hanging."""
    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:
        future = executor.submit(ollama.chat, model=model, messages=messages, tools=tools, options=options)
        try:
            return future.result(timeout=timeout)
        except concurrent.futures.TimeoutError:
            return None

