        tool_names = [
            call["function"]["name"].replace("get_", "").replace("perform_", "").replace("_", " ").title() 
            for call in response["message"]["tool_calls"]
        ]
        notify("AI Assistant", f"Query: {query}\nUsing tools: {', '.join(tool_names)}", urgency="low")
        
        for call in response["message"]["tool_calls"]:
            func_name = call["function"]["name"]
            args = call["function"]["arguments"]
            
            if func_name in tool_map:
                print(f"Executing tool: {func_name} with {args}")
                tool_result = tool_map[func_name](**args)
                
                messages.append({
                    "role": "tool",
                    "content": str(tool_result),
                    "name": func_name
                })
        
        response = safe_ollama_chat(
            model=TEXT_MODEL,
            messages=messages,
            tools=available_tools,
            options={"keep_alive": -1, "num_ctx": 8192},
            timeout=12
        )
        if response:
            messages.append(response["message"])

    answer = response.get("message", {}).get("content", "").strip() if response else "I've processed the tools but don't have a spoken response."
    if not answer:
        answer = "I've processed the tools but don't have a spoken response."
        
    print(f"AI: {answer}")
    
    save_history([m for m in messages if m["role"] in ["user", "assistant"]])
    
    notify("AI Assistant", f"Query: {query}\n\n{answer}", urgency="normal")
    if speak:
        subprocess.run([ALBA_PATH, "0.85", normalize_speech_text(answer)])

def handle_voice_query():
    audio_file = record_until_silence()
    query = transcribe_audio(audio_file)
    if not query:
        fallback_msg = "I didn't catch that."
        notify("AI Assistant", fallback_msg, urgency="normal")
        subprocess.run([ALBA_PATH, "0.85", normalize_speech_text(fallback_msg)])
        return
    handle_query_execution(query, speak=True)

def handle_text_query(query: str):
    if not query.strip():
        print("Error: Empty query provided.")
        return
    handle_query_execution(query, speak=False)

def handle_vision_query():
    """Capture a screen region and analyze it with a lightweight vision model."""
    tf = tempfile.NamedTemporaryFile(suffix=".png", delete=False)
    screenshot_path = tf.name
    tf.close()

    region = subprocess.run(["slurp"], capture_output=True, text=True)
    if region.returncode != 0:
        if os.path.exists(screenshot_path):
            os.unlink(screenshot_path)
        return

    subprocess.run(["grim", "-g", region.stdout.strip(), screenshot_path])

    prompt = "Describe what is on this screen or answer any text/code visible in it concisely."
    
    response = ollama.chat(
        model=VISION_MODEL,
        messages=[{
            'role': 'user',
            'content': prompt,
            'images': [screenshot_path]
        }],
        options={"keep_alive": -1}
    )
    
    if os.path.exists(screenshot_path):
        os.unlink(screenshot_path)
        
    analysis = response["message"]["content"].strip()
    print(f"Vision AI: {analysis}")
    
    notify("Vision Assistant", analysis, urgency="normal")
    subprocess.run([ALBA_PATH, "0.85", normalize_speech_text(analysis)])

def main():
    if len(sys.argv) < 2:
        print("Usage: ai-assist [voice|vision|text|clear]")
        sys.exit(1)
        
    mode = sys.argv[1]
    if mode == "voice":
        handle_voice_query()
    elif mode == "vision":
        handle_vision_query()
    elif mode == "text":
        query = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else ""
        if query:
            handle_text_query(query)
        else:
            print("Usage: ai-assist text \"your query here\"")
    elif mode == "clear":
        clear_history()
    else:
        print("Usage: ai-assist [voice|vision|text|clear]")

if __name__ == "__main__":
    main()
