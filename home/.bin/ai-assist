ABBREVIATIONS = {
    re.compile(r'\bvs\.\b', re.IGNORECASE): 'versus',
    re.compile(r'\be\.g\.\b', re.IGNORECASE): 'for example',
    re.compile(r'\bi\.e\.\b', re.IGNORECASE): 'that is',
    re.compile(r'\betc\.\b', re.IGNORECASE): 'et cetera',
    re.compile(r'\bapprox\.\b', re.IGNORECASE): 'approximately',
    re.compile(r'\bkm/h\b', re.IGNORECASE): 'kilometers per hour',
    re.compile(r'\bmph\b', re.IGNORECASE): 'miles per hour'
}

PATTERNS = {
    'currency': re.compile(r'\$(\d{1,3}(?:,\d{3})*|\d+)'),
    'temp': re.compile(r'([+-]?\d+)\s*°([CcFf])\b'),
    'percent': re.compile(r'(\d+)%'),
    'time': re.compile(r'\b(\d{1,2}):(\d{2})\s*([APap]\.?[Mm]\.?)?'),
    'months': re.compile(r'\b(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2})(?:st|nd|rd|th)?\b', re.IGNORECASE),
}

UNIT_PATTERNS = [
    (re.compile(rf'(?<!\w)(\d+(?:[.,]\d+)?)\s*{unit}\b', re.IGNORECASE), spoken)
    for unit, spoken in [
        (r'km/h', 'kilometers per hour'), (r'mph', 'miles per hour'),
        (r'km', 'kilometers'), (r'mi', 'miles'), (r'm', 'meters'),
        (r'cm', 'centimeters'), (r'mm', 'millimeters'), (r'in', 'inches'), 
        (r'ft', 'feet'), (r'yd', 'yards'), (r'kg', 'kilograms'), 
        (r'g', 'grams'), (r'lbs?', 'pounds'), (r'oz', 'ounces')
    ]
]

FILE_EXT_PATTERNS = [
    (re.compile(r'\b(\w+)\.py\b', re.IGNORECASE), r'\1 python script'),
    (re.compile(r'\b(\w+)\.json\b', re.IGNORECASE), r'\1 j s n file'),
    (re.compile(r'\b(\w+)\.conf\b', re.IGNORECASE), r'\1 config file'),
    (re.compile(r'\b(\w+)\.lua\b', re.IGNORECASE), r'\1 lua script')
]

DIGIT_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine']

@lru_cache(maxsize=32)
def number_to_ordinal(n: int) -> str:
    ordinals = {
        1: "first", 2: "second", 3: "third", 4: "fourth", 5: "fifth",
        6: "sixth", 7: "seventh", 8: "eighth", 9: "ninth", 10: "tenth",
        11: "eleventh", 12: "twelfth", 13: "thirteenth", 14: "fourteenth", 15: "fifteenth",
        16: "sixteenth", 17: "seventeenth", 18: "eighteenth", 19: "nineteenth", 20: "twentieth",
        21: "twenty-first", 22: "twenty-second", 23: "twenty-third", 24: "twenty-fourth", 25: "twenty-fifth",
        26: "twenty-sixth", 27: "twenty-seventh", 28: "twenty-eighth", 29: "twenty-ninth", 30: "thirtieth",
        31: "thirty-first"
    }
    return ordinals.get(n, str(n))

def normalize_speech_text(text: str) -> str:
    text = re.sub(r'[*`_#]', '', text)
    text = re.sub(r'[()]', ', ', text)
    
    for pattern, replacement in ABBREVIATIONS.items():
        text = pattern.sub(replacement, text)
    
    text = PATTERNS['currency'].sub(lambda m: f"{m.group(1).replace(',', '')} dollars", text)
    
    def replace_temp(m):
        val, scale = m.group(1), "Celsius" if m.group(2).upper() == 'C' else "Fahrenheit"
        prefix = "minus " if val.startswith('-') else ""
        return f"{prefix}{val.lstrip('+-')} degrees {scale}"
    text = PATTERNS['temp'].sub(replace_temp, text)
    
    text = PATTERNS['percent'].sub(r'\1 percent', text)
    
    for pattern, spoken in UNIT_PATTERNS:
        text = pattern.sub(rf'\1 {spoken}', text)
    
    for pattern, replacement in FILE_EXT_PATTERNS:
        text = pattern.sub(replacement, text)
    
    def time_replacer(m):
        hour = str(int(m.group(1)))
        minute = m.group(2)
        ampm = m.group(3) or ""
        
        if minute == '00':
            min_spoken = "o'clock"
        elif minute.startswith('0'):
            min_spoken = f"oh {DIGIT_WORDS[int(minute[1])]}"
        else:
            min_spoken = minute
        
        ampm_fmt = ""
        if ampm:
            clean = ampm.lower().replace('.', '')
            ampm_fmt = " A M" if clean == 'am' else " P M" if clean == 'pm' else ""
        
        return f"{hour} {min_spoken}{ampm_fmt}"
    
    text = PATTERNS['time'].sub(time_replacer, text)
    
    def replace_date(m):
        day = int(m.group(2))
        return f"{m.group(1)} {number_to_ordinal(day)}" if 1 <= day <= 31 else m.group(0)
    
    text = PATTERNS['months'].sub(replace_date, text)
    return text

# ==========================================
# NOTIFICATION & TTS UTILITIES
# ==========================================
def notify(title: str, message: str, urgency: str = "low", expire: str = "0") -> None:
    try:
        subprocess.run(
            ["notify-send", "-r", NOTIF_ID, "-u", urgency, "-t", expire, title, message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        logger.debug(f"Notification failed: {e}")

def speak_text(text: str) -> None:
    alba = get_conf_val('Paths', 'alba_path', expand_user=True)
    if not os.path.exists(alba):
        return
    try:
        normalized = normalize_speech_text(text)
        # Introduce subtle speech rate variance for organic vocal texture
        speed = str(round(random.uniform(0.96, 1.04), 2))
        subprocess.run([alba, speed, normalized], timeout=15, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        logger.warning("TTS timeout")

