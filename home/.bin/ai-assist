def get_time(*args) -> str:
    return f"The time is right now {datetime.datetime.now().strftime('%-I:%M %p')}."

def get_date(*args) -> str:
    return f"Today happens to be {datetime.datetime.now().strftime('%A, %B %-d, %Y')}."

def get_weather(location: str = "") -> str:
    loc = (location or get_conf_val('General', 'default_location')).strip()
    try:
        url = f"https://geocoding-api.open-meteo.com/v1/search?name={urllib.parse.quote(loc)}&count=1&format=json"
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'AIAssist'}), timeout=2) as res:
            results = json.loads(res.read())["results"]
            if not results: return f"Could not find weather for {loc}."
            lat, lon, name = results[0]["latitude"], results[0]["longitude"], results[0]["name"]
        
        url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,weather_code"
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'AIAssist'}), timeout=2) as res:
            data = json.loads(res.read())["current"]
            temp = data['temperature_2m']
            code = data['weather_code']
            
            wmo_codes = {
                0: "Clear sky", 1: "Mainly clear", 2: "Partly cloudy", 3: "Overcast",
                45: "Fog", 48: "Depositing rime fog", 51: "Light drizzle", 53: "Moderate drizzle",
                55: "Dense drizzle", 61: "Slight rain", 63: "Moderate rain", 65: "Heavy rain",
                71: "Slight snow fall", 73: "Moderate snow fall", 75: "Heavy snow fall",
                80: "Slight rain showers", 81: "Moderate rain showers", 82: "Violent rain showers",
                95: "Thunderstorm", 96: "Thunderstorm with slight hail", 99: "Thunderstorm with heavy hail"
            }
            condition = wmo_codes.get(code, "Unknown conditions")
            return f"Weather in {name}: {condition}, sitting at {temp}°C."
    except Exception as e:
        return f"Weather lookup failed: {e}"

def get_local_headlines(*args) -> str:
    loc = get_conf_val('General', 'default_location') or "London, Ontario"
    try:
        from duckduckgo_search import DDGS
        results = DDGS().text(f"{loc} news headlines", max_results=4, backend="auto")
        if not results:
            return f"No recent headlines found for {loc}."
        headlines = [f"• {r.get('title', 'Untitled')}: {r.get('body', '')}" for r in results]
        return f"Top local headlines for {loc}:\n" + "\n".join(headlines)
    except Exception as e:
        return f"Headlines lookup failed: {e}"

def get_system_logs(*args) -> str:
    try:
        res = subprocess.run(["journalctl", "-p", "err", "-b", "--no-pager", "-n", "3"], capture_output=True, text=True, timeout=1)
        return res.stdout.strip() or "All quiet on the western front—no recent system errors found."
    except Exception:
        return "System logs unavailable."

def get_recent_emails(*args) -> str:
    user = get_conf_val('Credentials', 'gmail_user')
    pwd = get_conf_val('Credentials', 'gmail_pass')
    if not user or not pwd: 
        return "Email credentials not configured."
    try:
        import imaplib, email
        from email.header import decode_header
        mail = imaplib.IMAP4_SSL("imap.gmail.com", timeout=10.0)
        mail.login(user, pwd)
        mail.select("inbox")
        _, messages = mail.search(None, '(UNSEEN)')
        ids = messages[0].split()
        if not ids: 
            mail.logout()
            return "Your inbox is pristine—zero unread emails waiting for you."
        
        out = []
        for i in ids[-3:]:
            _, msg_data = mail.fetch(i, '(BODY.PEEK[HEADER.FIELDS (Subject)])')
            for response_part in msg_data:
                if isinstance(response_part, tuple):
                    msg = email.message_from_bytes(response_part[1])
                    raw_subj = msg.get("Subject")
                    if raw_subj:
                        decoded_parts = decode_header(raw_subj)
                        subject = "".join([
                            part.decode(enc or "utf-8", errors="ignore") if isinstance(part, bytes) else part
                            for part, enc in decoded_parts
                        ])
                    else:
                        subject = "No Subject"
                    out.append(f"'{subject}'")
        mail.logout()
        return f"You've got {len(ids)} unread messages calling your name. Recent subjects: {', '.join(out)}."
    except Exception as e:
        logger.error(f"Email fetch exception: {e}")
        return f"Email error: {e}"

def get_calendar_events(*args) -> str:
    url = get_conf_val('Credentials', 'calendar_url')
    if not url: return "Calendar not configured."
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'AIAssist'}), timeout=3) as res:
            cal = res.read().decode()
        events = re.findall(r'BEGIN:VEVENT.*?SUMMARY:([^\n\r]+).*?DTSTART[^\:]*\:([0-9TZ]+).*?END:VEVENT', cal, re.DOTALL)
        today = datetime.datetime.now().strftime("%Y%m%d")
        upcoming = [f"'{s.strip()}' on {d.strip()[:8]}" for s, d in events if d.strip() >= today]
        return "Upcoming agenda: " + " | ".join(upcoming[:3]) if upcoming else "Your schedule is wide open and looking peaceful."
    except Exception as e:
        return f"Calendar error: {e}"

