    return "Securing your station. Locking screen now!"

def perform_web_search(query: str) -> str:
    try:
        from duckduckgo_search import DDGS
        results = DDGS().text(query, max_results=4, backend="auto")
        return "\n".join([r['body'] for r in results]) if results else "No web results."
    except Exception as e:
        return f"Web search failed: {e}"

def perform_wikipedia_search(query: str) -> str:
    try:
        url = f"https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch={urllib.parse.quote(query)}&format=json&srlimit=1"
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'AIAssist'}), timeout=3) as res:
            title = json.loads(res.read().decode())["query"]["search"][0]["title"]
            sum_url = f"https://en.wikipedia.org/api/rest_v1/page/summary/{urllib.parse.quote(title)}"
            with urllib.request.urlopen(urllib.request.Request(sum_url, headers={'User-Agent': 'AIAssist'}), timeout=3) as sum_res:
                return json.loads(sum_res.read().decode()).get("extract", "No extract found.")
    except Exception:
        return "Wikipedia search failed."

# ==========================================
# INTENT ROUTING (Fast-Path)
# ==========================================
def route_fast_path(query: str) -> Optional[str]:
    q = query.lower().strip()
    if any(k in q for k in ['email', 'inbox', 'messages', 'unread']):
        return get_recent_emails()
    if any(k in q for k in ['calendar', 'schedule', 'events']):
        return get_calendar_events()
    if any(k in q for k in ['news', 'headlines', 'local paper', 'what is happening', 'current events']):
        return get_local_headlines()
    if 'time' in q and 'date' not in q:
        return get_time()
    if any(k in q for k in ['date', 'day is today', 'what day']):
        return get_date()
    if 'weather' in q or 'forecast' in q:
        loc = ""
        for marker in ['in ', 'for ', 'at ']:
            if marker in q:
                parts = q.split(marker)
                if len(parts) > 1:
                    loc = parts[-1].strip('? .')
        return get_weather(loc)
    if any(k in q for k in ['status', 'logs', 'errors']):
        return get_system_logs()
    if any(k in q for k in ['clear history', 'wipe memory', 'reset context']):
        return clear_history_cmd()
    if 'lock screen' in q or 'lock display' in q:
        return lock_screen_cmd()
    return None

# ==========================================
# LLM ENGINE WITH TEMPORAL & NUMERICAL RULES
# ==========================================
def execute_llm_query(query: str, speak: bool = True):
    notify("AI Assistant", f"Analyzing query: '{query}'", urgency="low")
    
    hist_file = get_conf_val('Paths', 'history_file', expand_user=True)
    kb_file = get_conf_val('Paths', 'kb_file', expand_user=True)
    history = []
    if os.path.exists(hist_file):
        with open(hist_file, 'r') as f:
            history = json.load(f)
            
    kb = ""
    if os.path.exists(kb_file):
        with open(kb_file, 'r') as f: kb = f.read()

    sys_prompt = f"You are a vibrant, wonderfully loquacious, witty, and exceptionally fun AI companion for {get_conf_val('General', 'user_name')}. Embrace a lively tone, rich detail, and delightful prose while answering. You have direct command over system logs, web searches, Wikipedia, unread emails, local headlines, and calendar schedules via tools. KB: {kb}\n"
    sys_prompt += "CRITICAL INSTRUCTION: If there are no citations or ambiguities for an answer, respond with 'I'm not sure.'\n"
    sys_prompt += "CRITICAL CONSTRAINT: Strict numerical and temporal accuracy required. When comparing timeframes in years (e.g., X years ago vs Y years ago), a larger number represents a longer duration and a date further in the past. Never claim a larger number of years is shorter or more recent than a smaller number."
    
    if not history or history[0].get("role") != "system":
        history.insert(0, {"role": "system", "content": sys_prompt})
    history.append({"role": "user", "content": query})

    available_tools = [get_time, get_weather, get_local_headlines, get_system_logs, get_recent_emails, get_calendar_events, perform_web_search, perform_wikipedia_search]

    import ollama
    model = get_conf_val('General', 'text_model')
    options = {"keep_alive": -1, "num_ctx": 4096, "temperature": 0.4}

    def chat_call(msgs, tools=None):
        try:
            with concurrent.futures.ThreadPoolExecutor(1) as pool:
                return pool.submit(ollama.chat, model=model, messages=msgs, tools=tools, options=options).result(timeout=45)
        except Exception as e:
            logger.error(f"Ollama err: {e}")
            return None

    notify("AI Assistant", "Evaluating prompt and determining required actions...", urgency="low")
    res = chat_call(history, tools=available_tools)
    
    if res and res.get("message", {}).get("tool_calls"):
        for call in res["message"]["tool_calls"]:
            fname = call["function"]["name"].replace('get_', '').replace('perform_', '').replace('_', ' ').title()
            notify("AI Assistant", f"Calling tool: {fname}", urgency="low")
        
        history.append(res["message"])
        tool_map = {t.__name__: t for t in available_tools}
        for call in res["message"]["tool_calls"]:
            fname = call["function"]["name"]
            args = call["function"]["arguments"]
            if fname in tool_map:
                out = str(tool_map[fname](**args))
                history.append({"role": "tool", "content": out, "name": fname})
        notify("AI Assistant", "Processing tool results...", urgency="low")
        res = chat_call(history, tools=available_tools)

    answer = res["message"]["content"].strip() if res else "I'm not sure."

    if "i'm not sure" in answer.lower():
        notify("AI Assistant", "Initial response uncertain. Running fallback tool verification...", urgency="low")
        fallback_sequence = [
            get_local_headlines,
            perform_wikipedia_search,
            perform_web_search,
            get_recent_emails,
            get_system_logs
        ]
        
        resolved = False
        for tool in fallback_sequence:
            tool_name = tool.__name__.replace('_', ' ').replace('perform ', '').title()
            notify("AI Assistant", f"Consulting fallback source: {tool_name}", urgency="low")
            tool_result = tool(query)
            if not tool_result or "failed" in tool_result.lower() or "unavailable" in tool_result.lower() or "no web results" in tool_result.lower() or "no recent headlines" in tool_result.lower():
                continue
                
            eval_msgs = [
                {"role": "system", "content": "You are a lively, expressive AI assistant. Answer the query using ONLY the provided Context, keeping your entertaining and loquacious flair while maintaining strict numerical and temporal accuracy (a larger number of years ago means a longer duration). If the Context lacks the answer, reply EXACTLY with 'I'm not sure.'"},
                {"role": "user", "content": f"Query: {query}\n\nContext:\n{tool_result}"}
            ]
            eval_res = chat_call(eval_msgs)
            if eval_res:
                eval_answer = eval_res["message"]["content"].strip()
                if "i'm not sure" not in eval_answer.lower():
                    answer = eval_answer
                    history.append({"role": "assistant", "content": answer})
                    resolved = True
                    notify("AI Assistant", f"Resolved query via {tool_name}", urgency="low")
                    break
        
        if not resolved:
            answer = "I've scoured every corner of my knowledge bases, but I'm not sure about that one!"
    else:
        history.append({"role": "assistant", "content": answer})

    print(f"AI: {answer}")
    notify("AI Assistant", f"Query: {query}\n\n{answer}", urgency="normal")
    if speak: speak_text(answer)

    max_h = int(get_conf_val('General', 'max_history'))
    with open(hist_file, 'w') as f:
        json.dump([m for m in history if m["role"] in ["user", "assistant"]][-max_h:], f)

