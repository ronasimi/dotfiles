def get_weather(location: str = "London, Ontario") -> str:
    """Gets the current weather forecast and conditions for any specified city or location."""
    try:
        loc_query = location if location else "London, Ontario"
        encoded_loc = urllib.parse.quote(loc_query)
        
        geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={encoded_loc}&count=1&format=json"
        geo_req = urllib.request.Request(geo_url, headers={'User-Agent': 'AIAssistant/1.0'})
        
        with urllib.request.urlopen(geo_req, timeout=3) as geo_res:
            geo_data = json.loads(geo_res.read().decode('utf-8'))
            results = geo_data.get("results", [])
            if not results:
                return f"Could not find location: {loc_query}."
            
            lat = results[0].get("latitude")
            lon = results[0].get("longitude")
            resolved_name = results[0].get("name", loc_query)
            country = results[0].get("country", "")
            location_label = f"{resolved_name}, {country}" if country else resolved_name

        weather_url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,weather_code"
        weather_req = urllib.request.Request(weather_url, headers={'User-Agent': 'AIAssistant/1.0'})
        
        with urllib.request.urlopen(weather_req, timeout=3) as weather_res:
            weather_data = json.loads(weather_res.read().decode('utf-8'))
            current = weather_data.get("current", {})
            temp = current.get("temperature_2m")
            code = current.get("weather_code")
            
            wmo_codes = {
                0: "Clear sky", 1: "Mainly clear", 2: "Partly cloudy", 3: "Overcast",
                45: "Fog", 48: "Depositing rime fog",
                51: "Light drizzle", 53: "Moderate drizzle", 55: "Dense drizzle",
                56: "Light freezing drizzle", 57: "Dense freezing drizzle",
                61: "Slight rain", 63: "Moderate rain", 65: "Heavy rain",
                66: "Light freezing rain", 67: "Heavy freezing rain",
                71: "Slight snow fall", 73: "Moderate snow fall", 75: "Heavy snow fall",
                77: "Snow grains", 80: "Slight rain showers", 81: "Moderate rain showers", 
                82: "Violent rain showers", 85: "Slight snow showers", 86: "Heavy snow showers",
                95: "Thunderstorm", 96: "Thunderstorm with slight hail", 99: "Thunderstorm with heavy hail"
            }
            
            condition = wmo_codes.get(code, "Conditions unknown")
            
            if temp is not None:
                return f"Current weather in {location_label}: {condition}, {temp}°C"
                
        return f"Weather data unavailable for {loc_query}."
    except Exception as e:
        return f"Weather lookup failed: {e}"

def extract_location(query: str) -> str:
    """Robustly extracts a target city name from natural language queries."""
    q = re.sub(r'[^\w\s,]', ' ', query.lower())
    words = q.split()
    stop_words = {
        "what", "is", "are", "was", "were", "the", "weather", "forecast", "like", "in", "for", 
        "at", "around", "current", "currently", "today", "tomorrow", 
        "whats", "what's", "can", "you", "tell", "me", "please", "now", "it",
        "headlines", "headline", "news", "recent", "latest"
    }
    city_words = [w for w in words if w not in stop_words]
    return " ".join(city_words) if city_words else "London, Ontario"

