def number_to_ordinal(n: int) -> str:
    ordinals = {
        1: "first", 2: "second", 3: "third", 4: "fourth", 5: "fifth",
        6: "sixth", 7: "seventh", 8: "eighth", 9: "ninth", 10: "tenth",
        11: "eleventh", 12: "twelfth", 13: "thirteenth", 14: "fourteenth", 15: "fifteenth",
        16: "sixteenth", 17: "seventeenth", 18: "eighteenth", 19: "nineteenth", 20: "twentieth",
        21: "twenty-first", 22: "twenty-second", 23: "twenty-third", 24: "twenty-fourth", 25: "twenty-fifth",
        26: "twenty-sixth", 27: "twenty-seventh", 28: "twenty-eighth", 29: "twenty-ninth", 30: "thirtieth",
        31: "thirty-first"
    }
    return ordinals.get(n, str(n))

def normalize_speech_text(text: str) -> str:
    """Normalize symbols, numbers, and abbreviations for clean TTS speech output."""
    for pattern, replacement in ABBREVIATIONS.items():
        text = pattern.sub(replacement, text)

    text = CURRENCY_PATTERN.sub(lambda m: f"{m.group(1).replace(',', '')} dollars", text)

    def replace_temp(match):
        val, scale = match.group(1), "Celsius" if match.group(2).upper() == 'C' else "Fahrenheit"
        prefix = "minus " if val.startswith('-') else ""
        return f"{prefix}{val.lstrip('+-')} degrees {scale}"
    text = TEMP_PATTERN.sub(replace_temp, text)

    text = PERCENT_PATTERN.sub(r'\1 percent', text)

    for pattern, spoken in UNIT_PATTERNS:
        text = pattern.sub(rf'\1 {spoken}', text)

    for pattern, replacement in FILE_EXT_PATTERNS:
        text = pattern.sub(replacement, text)

    def time_replacer(match):
        hour, minute, ampm = match.group(1), match.group(2), match.group(3) if match.lastindex >= 3 and match.group(3) else ""
        
        hour = str(int(hour))
        
        if minute == '00': min_spoken = "o'clock"
        elif minute.startswith('0'): min_spoken = f"oh {DIGIT_WORDS[int(minute[1])]}"
        else: min_spoken = minute

        ampm_formatted = ""
        if ampm:
            clean_ampm = ampm.lower().replace('.', '')
            if clean_ampm == 'am': ampm_formatted = " A M"
            elif clean_ampm == 'pm': ampm_formatted = " P M"
            
        return f"{hour} {min_spoken}{ampm_formatted}"
    text = TIME_PATTERN.sub(time_replacer, text)

    def replace_date(match):
        day = int(match.group(2))
        return f"{match.group(1)} {number_to_ordinal(day)}" if 1 <= day <= 31 else match.group(0)
    text = MONTHS_PATTERN.sub(replace_date, text)
    
    return text

