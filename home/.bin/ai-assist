def get_local_headlines(location: str = "London, Ontario") -> str:
    """Gets the latest local news headlines for any arbitrary location using GNews."""
    try:
        loc_query = location if location else "London, Ontario"
        google_news = GNews(language='en', country='CA', period='1d', max_results=3)
        results = google_news.get_news(loc_query)
        if not results:
            results = google_news.get_news_by_location(loc_query)
        
        headlines = [item.get('title', '') for item in results[:3]]
        return "\n".join(headlines) if headlines else f"No headlines found for {loc_query}."
    except Exception as e:
        return f"News lookup failed: {e}"

def get_calendar_events() -> str:
    """Retrieves the user's upcoming calendar schedule and events directly from their private Google Calendar iCal feed."""
    url = "https://calendar.google.com/calendar/ical/ron.asimi%40gmail.com/private-1e9d8c301385f504d080075c62969e85/basic.ics"
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'AIAssistant/1.0'})
        with urllib.request.urlopen(req, timeout=4) as response:
            cal_data = response.read().decode('utf-8')
            
        events_raw = re.findall(r'BEGIN:VEVENT(.*?)END:VEVENT', cal_data, re.DOTALL)
        upcoming_events = []
        today_str = datetime.datetime.now().strftime("%Y%m%d")
        
        for event in events_raw:
            summary_match = re.search(r'SUMMARY:([^\n\r]+)', event)
            dtstart_match = re.search(r'DTSTART[^\:]*\:([0-9TZ]+)', event)
            
            if summary_match and dtstart_match:
                summary = summary_match.group(1).strip()
                dtstart = dtstart_match.group(1).strip()
                
                if dtstart >= today_str or "RRULE:" in event:
                    formatted_time = dtstart.replace('T', ' at ').replace('Z', ' (UTC)')
                    upcoming_events.append(f"Event: '{summary}' starting {formatted_time}")
        
        if not upcoming_events:
            return "No upcoming calendar events found."
            
        upcoming_events.sort(key=lambda x: x.split("starting ")[-1])
        return "Upcoming Schedule:\n" + "\n".join(upcoming_events[:15])
    except Exception as e:
        return f"Calendar lookup failed: {e}"

