def handle_text(query: str, speak: bool = False):
    print(f"Query: {query}")
    ans = route_fast_path(query)
    if ans:
        print(f"Fast AI: {ans}")
        notify("AI Assistant", f"Query: {query}\n\n{ans}", urgency="normal")
        if speak: speak_text(ans)
        return
    execute_llm_query(query, speak)

def handle_voice():
    notify("AI Assistant", "Listening...", urgency="low")
    import sounddevice as sd
    import numpy as np
    from faster_whisper import WhisperModel
    
    fs, block_dur, silence_dur = 16000, 0.1, 0.5
    block_sz = int(fs * block_dur)
    frames, speech_started, silent_blocks = [], False, 0
    
    print("Speak now...")
    with sd.InputStream(samplerate=fs, channels=1, dtype='int16', blocksize=block_sz) as stream:
        for _ in range(int(8.0 / block_dur)):
            data, _ = stream.read(block_sz)
            rms = np.sqrt(np.mean((data.astype(np.float32) / 32768.0)**2))
            frames.append(data)
            if rms > 0.030:
                speech_started, silent_blocks = True, 0
            elif speech_started:
                silent_blocks += 1
                if silent_blocks >= int(silence_dur / block_dur): break
    
    notify("AI Assistant", "Transcribing...", urgency="low")
    tf = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
    with wave.open(tf.name, 'wb') as wf:
        wf.setnchannels(1); wf.setsampwidth(2); wf.setframerate(fs)
        wf.writeframes(np.concatenate(frames, axis=0).tobytes())
    
    try:
        model = WhisperModel("base.en", device="cpu", compute_type="int8")
        segments, _ = model.transcribe(tf.name, beam_size=1)
        query = " ".join([s.text for s in segments]).strip()
        if not query: raise ValueError("Silence")
        handle_text(query, speak=True)
    except Exception as e:
        logger.error(f"Voice error: {e}")
        notify("AI Assistant", "Hmm, I didn't quite catch that.", urgency="normal")
    finally:
        os.unlink(tf.name)

def handle_vision():
    tf = tempfile.NamedTemporaryFile(suffix=".png", delete=False)
    try:
        reg = subprocess.run(["slurp"], capture_output=True, text=True).stdout.strip()
        if not reg: return
        subprocess.run(["grim", "-g", reg, tf.name])
        
        import ollama
        notify("AI Assistant", "Analyzing captured screen content...", urgency="low")
        res = ollama.chat(
            model=get_conf_val('General', 'vision_model'),
            messages=[{'role': 'user', 'content': 'Provide an expressive, fun breakdown of what is on this screen.', 'images': [tf.name]}],
            options={"keep_alive": -1, "temperature": 0.4}
        )
        ans = res["message"]["content"].strip()
        print(f"Vision: {ans}")
        notify("AI Assistant", f"Query: Screen analysis\n\n{ans}", urgency="normal")
        speak_text(ans)
    finally:
        os.unlink(tf.name)

# ==========================================
# MAIN
# ==========================================
if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: ai-assist [voice|vision|text|clear]")
        sys.exit(1)
    
    mode = sys.argv[1]
    if mode == "text":
        handle_text(" ".join(sys.argv[2:]), speak=False)
    elif mode == "voice":
        handle_voice()
    elif mode == "vision":
        handle_vision()
    elif mode == "clear":
        print(clear_history_cmd())
    else:
        print("Unknown mode")
