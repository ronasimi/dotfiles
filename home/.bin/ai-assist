def record_until_silence(fs=16000, block_duration=0.1, silence_duration=0.4, threshold=0.030, max_duration=5.0):
    """Record microphone audio dynamically with configured threshold and silence timeout."""
    print("Recording... Speak now.")
    notify("AI Assistant", "Recording... Speak now.", urgency="low")
    
    block_size = int(fs * block_duration)
    frames = []
    speech_started = False
    silent_blocks = 0
    max_silent_blocks = int(silence_duration / block_duration)
    max_blocks = int(max_duration / block_duration)
    
    with sd.InputStream(samplerate=fs, channels=1, dtype='int16', blocksize=block_size) as stream:
        for _ in range(max_blocks):
            data, overflowed = stream.read(block_size)
            if overflowed:
                continue
            
            audio_float = data.astype(np.float32) / 32768.0
            rms = np.sqrt(np.mean(audio_float**2))
            
            frames.append(data)
            
            if rms > threshold:
                speech_started = True
                silent_blocks = 0
            elif speech_started:
                silent_blocks += 1
                if silent_blocks >= max_silent_blocks:
                    break
            else:
                if len(frames) > int(2.0 / block_duration):
                    break
                    
    notify("AI Assistant", "Transcribing audio...", urgency="low")
    
    audio_data = np.concatenate(frames, axis=0)
    
    temp_file = tempfile.NamedTemporaryFile(suffix=".wav", delete=False)
    temp_file.close()
    
    with wave.open(temp_file.name, 'wb') as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(fs)
        wf.writeframes(audio_data.tobytes())
        
    return temp_file.name

def transcribe_audio(audio_path):
    """Transcribe recorded audio using local faster-whisper."""
    model = WhisperModel("base.en", device="cpu", compute_type="int8")
    segments, _ = model.transcribe(audio_path, beam_size=1)
    text = " ".join([segment.text for segment in segments])
    os.unlink(audio_path)
    return text.strip()

