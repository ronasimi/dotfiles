#!/usr/bin/env python3
import sys
import subprocess

def main():
    args = sys.argv[1:]
    
    # Optional: check if the first argument is a float/speed multiplier
    length_scale = "1.0"
    if args and len(args) > 1:
        try:
            length_scale = str(float(args[0]))
            text = " ".join(args[1:])
        except ValueError:
            text = " ".join(args)
    else:
        # Read text from stdin or arguments normally
        if args:
            text = " ".join(args)
        else:
            text = sys.stdin.read()

    clean_text = text.replace("\n", " ").strip()
    if not clean_text:
        return

    # Pass the length_scale flag into piper-tts
    p1 = subprocess.Popen(
        [
            "piper-tts", 
            "--model", "/usr/share/piper-voices/en/en_GB/alba/medium/en_GB-alba-medium.onnx", 
            "--length_scale", length_scale,
            "--output_raw"
        ],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE
    )
    p2 = subprocess.Popen(
        ["pw-play", "--raw", "--rate", "22050", "--channels", "1", "--format", "s16", "-"],
        stdin=p1.stdout
    )
    p1.stdout.close()
    p1.communicate(input=clean_text.encode("utf-8"))
    p2.wait()

if __name__ == "__main__":
    main()
