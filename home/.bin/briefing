def number_to_ordinal(n: int) -> str:
    ordinals = {
        1: "first", 2: "second", 3: "third", 4: "fourth", 5: "fifth",
        6: "sixth", 7: "seventh", 8: "eighth", 9: "ninth", 10: "tenth",
        11: "eleventh", 12: "twelfth", 13: "thirteenth", 14: "fourteenth", 15: "fifteenth",
        16: "sixteenth", 17: "seventeenth", 18: "eighteenth", 19: "nineteenth", 20: "twentieth",
        21: "twenty-first", 22: "twenty-second", 23: "twenty-third", 24: "twenty-fourth", 25: "twenty-fifth",
        26: "twenty-sixth", 27: "twenty-seventh", 28: "twenty-eighth", 29: "twenty-ninth", 30: "thirtieth",
        31: "thirty-first"
    }
    return ordinals.get(n, str(n))

def normalize_speech_text(text: str) -> str:
    # Standalone abbreviations
    abbreviations = {
        r'\bvs\.\b': 'versus', r'\be\.g\.\b': 'for example',
        r'\bi\.e\.\b': 'that is', r'\betc\.\b': 'et cetera',
        r'\bapprox\.\b': 'approximately',
        r'\bkm/h\b': 'kilometers per hour',
        r'\bmph\b': 'miles per hour'
    }
    for pattern, replacement in abbreviations.items():
        text = re.sub(pattern, replacement, text, flags=re.IGNORECASE)

    def replace_currency(match):
        amount = match.group(1).replace(',', '')
        return f"{amount} dollars"
    text = re.sub(r'\$(\d{1,3}(?:,\d{3})*|\d+)', replace_currency, text)

    def replace_temp(match):
        val = match.group(1)
        scale = "Celsius" if match.group(2).upper() == 'C' else "Fahrenheit"
        if val.startswith('-'):
            return f"minus {val[1:]} degrees {scale}"
        elif val.startswith('+'):
            return f"{val[1:]} degrees {scale}"
        return f"{val} degrees {scale}"
    text = re.sub(r'([+-]?\d+)\s*°([CcFf])\b', replace_temp, text)

    text = re.sub(r'(\d+)%', r'\1 percent', text)

    # Distance, weight, and measurement units strictly attached to numbers
    unit_replacements = [
        (r'km/h', 'kilometers per hour'), (r'mph', 'miles per hour'),
        (r'km', 'kilometers'), (r'mi', 'miles'), (r'm', 'meters'),
        (r'cm', 'centimeters'), (r'mm', 'millimeters'),
        (r'in', 'inches'), (r'ft', 'feet'), (r'yd', 'yards'),
        (r'kg', 'kilograms'), (r'g', 'grams'), (r'lbs?', 'pounds'),
        (r'oz', 'ounces')
    ]
    for unit, spoken in unit_replacements:
        text = re.sub(rf'(?<!\w)(\d+(?:[.,]\d+)?)\s*{unit}\b', rf'\1 {spoken}', text, flags=re.IGNORECASE)

    text = re.sub(r'\b(\w+)\.py\b', r'\1 python script', text, flags=re.IGNORECASE)
    text = re.sub(r'\b(\w+)\.json\b', r'\1 j s o n file', text, flags=re.IGNORECASE)
    text = re.sub(r'\b(\w+)\.conf\b', r'\1 config file', text, flags=re.IGNORECASE)
    text = re.sub(r'\b(\w+)\.lua\b', r'\1 lua script', text, flags=re.IGNORECASE)

    digit_words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine']
    def time_replacer(match):
        hour = match.group(1)
        minute = match.group(2)
        ampm = match.group(3) if match.lastindex >= 3 and match.group(3) else ""
        
        if minute == '00': min_spoken = "o'clock"
        elif minute.startswith('0'): min_spoken = f"oh {digit_words[int(minute[1])]}"
        else: min_spoken = minute

        ampm_formatted = ""
        if ampm:
            clean_ampm = ampm.lower().replace('.', '')
            if clean_ampm == 'am': ampm_formatted = " in the morning"
            elif clean_ampm == 'pm':
                h_val = int(hour)
                ampm_formatted = " in the evening" if h_val >= 6 and h_val != 12 else " in the afternoon"
                
        return f"{hour} {min_spoken}{ampm_formatted}"

    text = re.sub(r'\b(\d{1,2}):(\d{2})\s*([APap]\.?[Mm]\.?)?', time_replacer, text)

    months_pattern = r'\b(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2})(?:st|nd|rd|th)?\b'
    def replace_date(match):
        month = match.group(1)
        day = int(match.group(2))
        return f"{month} {number_to_ordinal(day)}" if 1 <= day <= 31 else match.group(0)
        
    text = re.sub(months_pattern, replace_date, text, flags=re.IGNORECASE)
    return text

def get_greeting():
    hour = datetime.datetime.now().hour
    return "Good Morning" if hour < 12 else ("Good Afternoon" if hour < 18 else "Good Evening")

def get_weather():
    import urllib.request
    import urllib.parse
    try:
        encoded_loc = urllib.parse.quote(LOCATION)
        url = f"https://wttr.in/{encoded_loc}?format=%C+and+%t"
        req = urllib.request.Request(url, headers={'User-Agent': 'curl'})
        with urllib.request.urlopen(req, timeout=1.5) as response:
            return response.read().decode('utf-8').strip()
    except Exception:
        return "weather data currently unavailable"

def get_system_errors():
    try:
        result = subprocess.run(
            ["journalctl", "-p", "warning..err", "-b", "--no-pager", "-n", "3"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=1.0
        )
        lines = result.stdout.strip().split("\n")
        if not lines or lines[0] == "": return "No recent system warnings or errors."
        return "; ".join([line.split(": ", 1)[-1] for line in lines if line.strip()])
    except Exception:
        return "System log check failed."

def get_unread_emails():
    import imaplib
    import email
    from email.header import decode_header
    try:
        mail = imaplib.IMAP4_SSL("imap.gmail.com", timeout=4.0)
        mail.login(GMAIL_USER, GMAIL_PASS)
        mail.select("inbox")
        status, messages = mail.search(None, '(UNSEEN)')
        
        mail_ids = messages[0].split()
        count = len(mail_ids)
        
        if count == 0:
            mail.logout()
            return "You have zero unread emails."
            
        details = []
        for num in mail_ids[-3:]:
            status, msg_data = mail.fetch(num, '(BODY.PEEK[HEADER.FIELDS (Subject From)])')
            for response_part in msg_data:
                if isinstance(response_part, tuple):
                    msg = email.message_from_bytes(response_part[1])
                    
                    raw_subj = msg["Subject"]
                    subject = "".join([part.decode(enc or "utf-8", errors="ignore") if isinstance(part, bytes) else part for part, enc in decode_header(raw_subj)]) if raw_subj else "No Subject"
                        
                    raw_from = msg["From"]
                    sender = "".join([part.decode(enc or "utf-8", errors="ignore") if isinstance(part, bytes) else part for part, enc in decode_header(raw_from)]) if raw_from else "Unknown Sender"
                    if "<" in sender: sender = sender.split("<")[0].strip().strip('"')
                        
                    details.append(f"from {sender} about '{subject}'")
                    
        mail.logout()
        return f"You have {count} unread emails. Recent ones include: {', '.join(details)}."
    except Exception:
        return "email details unavailable"

def run_briefing():
    import ollama
    
    greeting = get_greeting()
    current_time = datetime.datetime.now().strftime("%I:%M %p")

    with concurrent.futures.ThreadPoolExecutor() as executor:
        future_weather = executor.submit(get_weather)
        future_system = executor.submit(get_system_errors)
        future_email = executor.submit(get_unread_emails)

        weather = future_weather.result()
        system_status = future_system.result()
        email_summary = future_email.result()

    try:
        os.makedirs(os.path.dirname(ERRORS_FILE), exist_ok=True)
        with open(ERRORS_FILE, "w") as f: f.write(system_status)
    except Exception:
        pass

    prompt = f"""
    Synthesize raw data into a warm, natural, and concise spoken briefing for {USER_NAME}.
    Data: Greeting: {greeting} | Time: {current_time} | Weather: {weather} | Email: {email_summary} | Health: {system_status}
    """

    p1, p2 = None, None
    try:
        p1 = subprocess.Popen(
            ["piper-tts", "--model", "/usr/share/piper-voices/en/en_GB/alba/medium/en_GB-alba-medium.onnx", "--length_scale", "0.85", "--output_raw"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE
        )
        p2 = subprocess.Popen(
            ["pw-play", "--raw", "--rate", "22050", "--channels", "1", "--format", "s16", "-"],
            stdin=p1.stdout
        )
        p1.stdout.close()
    except Exception:
        pass

    stream = ollama.chat(
        model=MODEL,
        messages=[{"role": "user", "content": prompt}],
        stream=True,
        options={"keep_alive": -1, "num_ctx": 8192, "num_predict": 500}
    )

    buffer = ""
    full_briefing = ""
    for chunk in stream:
        content = chunk['message']['content']
        buffer += content
        full_briefing += content
        
        # Playback trigger on punctuation boundary only
        match = re.search(r'[,.!?;\n]', buffer)
        
        if match:
            idx = match.end()
            sentence = buffer[:idx].strip()
            buffer = buffer[idx:]
            
            if sentence:
                clean_sent = normalize_speech_text(sentence).replace("\n", " ") + " "
                if p1 and p1.poll() is None:
                    try:
                        p1.stdin.write(clean_sent.encode("utf-8"))
                        p1.stdin.flush()
                    except Exception:
                        pass

    if buffer.strip():
        clean_sent = normalize_speech_text(buffer.strip()).replace("\n", " ") + " "
        if p1 and p1.poll() is None:
            try:
                p1.stdin.write(clean_sent.encode("utf-8"))
                p1.stdin.flush()
            except Exception:
                pass

    subprocess.Popen(
        ["notify-send", "-u", "normal", "-t", "0", "Daily Briefing", full_briefing.strip().replace("\n", " ")],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )

    if p1:
        try:
            p1.stdin.close()
            p1.wait()
            p2.wait()
        except Exception:
            pass

def main():
    if "--worker" not in sys.argv:
        subprocess.Popen(
            [sys.executable, __file__, "--worker"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True
        )
        sys.exit(0)
    
    run_briefing()

if __name__ == "__main__":
    main()
