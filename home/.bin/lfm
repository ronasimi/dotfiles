#!/usr/bin/env bash
# Multi-model Vulkan llama.cpp server controller for systemd --user.
set -euo pipefail
MODELS=(text omni decision)
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCK_DIR="$RUNTIME_DIR/lfm"
MODEL_DIR="$HOME/.models"
SYSTEMD_UNIT="$HOME/.config/systemd/user/lfm@.service"
SELF="$HOME/.bin/lfm"
usage() {
  cat <<'USAGE'
Usage: lfm setup | start [text|omni|decision|all] | stop [model|all]
           | restart [model|all] | switch [model|all] | status [model|all]
           | logs [model] | enable [model|all] | disable [model|all]

Defaults: all for start/stop/restart/status; text for switch/logs.
Local HTTP: text=8081, omni=8082, decision=8083.
Unix sockets: $XDG_RUNTIME_DIR/lfm/{text,omni,decision}.sock
USAGE
}
setup() {
  if [[ ! -x "$SELF" ]]; then
    printf 'Install this script first: install -Dm755 ./lfm %q\n' "$SELF" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$SYSTEMD_UNIT")"
  cat > "$SYSTEMD_UNIT" <<'UNIT'
[Unit]
Description=Local LFM %i Vulkan server (llama.cpp)
After=default.target

[Service]
Type=simple
ExecStart=%h/.bin/lfm serve %i
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  printf 'Installed %s\n' "$SYSTEMD_UNIT"
}
serve() {
  local target="$1" port model projector=""
  local -a args
  case "$target" in
    text)
      port=8081
      model="$MODEL_DIR/text/LFM3-1.7B-Q5_K_M.gguf"
      args=(--jinja -c 65536 -b 2048 -ub 512 --temp 0.1 --top-k 50 --repeat-penalty 1.1)
      ;;
    omni)
      port=8082
      model="$MODEL_DIR/omni/LFM3-Omni-2B-Q4_K_M.gguf"
      projector="$MODEL_DIR/omni/mmproj-LFM3-Omni-2B-Q4_K_M.gguf"
      args=(-c 8192 -b 2048 -ub 512 --temp 0 --reasoning off)
      ;;
    decision)
      port=8083
      model="$MODEL_DIR/decision/d1-omni-600M-Q8_0.gguf"
      projector="$MODEL_DIR/decision/mmproj-d1-omni-600M-Q8_0.gguf"
      args=(-c 1024 -b 1024 -ub 1024)
      ;;
    *) usage; exit 2 ;;
  esac
  if [[ ! -s "$model" ]]; then printf 'Missing model: %s\n' "$model" >&2; exit 1; fi
  if [[ -n "$projector" && ! -s "$projector" ]]; then printf 'Missing projector: %s\n' "$projector" >&2; exit 1; fi
  mkdir -p "$SOCK_DIR"
  chmod 0700 "$SOCK_DIR"
  rm -f "$SOCK_DIR/$target.sock"
  local -a mmproj=()
  [[ -z "$projector" ]] || mmproj=(-mm "$projector")
  exec /usr/local/bin/llama-server \
    -m "$model" "${mmproj[@]}" \
    --host "127.0.0.1,$SOCK_DIR/$target.sock" --port "$port" \
    --alias "lfm-$target" -ngl all --fit off -fa auto \
    -t 6 -tb 6 -np 1 "${args[@]}"
}
valid_target() {
  case "$1" in text|omni|decision|all) ;; *) usage; exit 2 ;; esac
}
run_for() {
  local verb="$1" target="$2" m
  valid_target "$target"
  local -a targets=("$target")
  [[ "$target" == all ]] && targets=("${MODELS[@]}")
  for m in "${targets[@]}"; do
    if [[ "$verb" == status ]]; then
      printf '%-9s %-12s http://127.0.0.1:%s %s\n' "$m" "$(systemctl --user is-active "lfm@$m.service" 2>/dev/null || true)" \
        "$(case "$m" in text) echo 8081;; omni) echo 8082;; decision) echo 8083;; esac)" "$SOCK_DIR/$m.sock"
    else
      printf '%s %s\n' "$verb" "$m"
      systemctl --user "$verb" "lfm@$m.service"
    fi
  done
}
command="${1:-}"; target="${2:-all}"
case "$command" in
  setup) setup ;;
  serve) serve "${2:?model required}" ;;
  start|stop|restart|status|enable|disable)
    [[ -f "$SYSTEMD_UNIT" || "$command" == status ]] || setup
    run_for "$command" "$target" ;;
  switch)
    target="${2:-text}"; valid_target "$target"
    [[ -f "$SYSTEMD_UNIT" ]] || setup
    run_for stop all
    run_for start "$target" ;;
  logs)
    target="${2:-text}"; valid_target "$target"
    if [[ "$target" == all ]]; then
      journalctl --user -u 'lfm@*.service' -n 100 --no-pager
    else
      journalctl --user -u "lfm@$target.service" -n 100 --no-pager
    fi ;;
  help|-h|--help|'') usage ;;
  *) usage; exit 2 ;;
esac
