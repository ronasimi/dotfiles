#!/usr/bin/env bash
# Multi-model Vulkan llama.cpp server controller for systemd --user.
set -euo pipefail
MODELS=(text omni decision)
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCK_DIR="$RUNTIME_DIR/lfm"
MODEL_DIR="${LFM_MODEL_DIR:-$HOME/.models}"
SERVER="${LFM_SERVER:-/usr/local/bin/llama-server}"
# No ~/.config/lfm/settings.sh or prewarm directory. Presets live in this script.
# Only the selected preset name is persisted (XDG_STATE_HOME, not XDG_CONFIG_HOME).
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/lfm"
PRESET_FILE="$STATE_DIR/preset"
for key in LFM_PI_CWD LFM_PI_SDK LFM_PI_BIN; do
  [[ ! -v "$key" ]] || export "$key"
done
SYSTEMD_UNIT="$HOME/.config/systemd/user/lfm@.service"
SELF="$HOME/.bin/lfm"
usage() {
  cat <<'USAGE'
Usage: lfm preset [show|list|balanced|fastest|memory-saving]
       lfm --preset [show|list|balanced|fastest|memory-saving]
       lfm setup | start [model|all] | stop [model|all]
           | restart [model|all] | switch [model|all] | status [model|all]
           | warmup [model] | command [model] | doctor | logs [model]
           | enable [model|all] | disable [model|all]

Presets: balanced (default), fastest, memory-saving.
Setting a preset saves it in ~/.local/state/lfm/preset (or XDG_STATE_HOME)
and restarts only the currently active model services.
Models: text=128K/Vulkan 8081; omni=32K 8082; decision=1K 8083.
All three use Q4_0 for causal KV where applicable; D1 has no causal KV.
No ~/.config/lfm settings or prewarm files are read.
Optional explicit prewarm payloads: LFM_TEXT_PREWARM_JSON,
LFM_OMNI_PREWARM_JSON, LFM_DECISION_PREWARM_JSON.
Default target: all for start/stop/restart/status; text for switch/logs.
USAGE
}
valid_preset() {
  case "$1" in balanced|fastest|memory-saving) return 0 ;; *) return 1 ;; esac
}
selected_preset() {
  local result=""
  if [[ -z "$result" && -s "$PRESET_FILE" ]]; then
    IFS= read -r result < "$PRESET_FILE" || true
  fi
  result="${result:-balanced}"
  if ! valid_preset "$result"; then
    printf 'Invalid saved LFM preset %q; use lfm preset balanced to reset.\n' "$result" >&2
    return 2
  fi
  printf '%s\n' "$result"
}
list_presets() {
  local selected
  selected="$(selected_preset)" || return
  printf 'Current preset: %s\n' "$selected"
  printf '  %-14s %-20s %s\n' 'Preset' 'Backends (T/O/D)' 'Batch/ubatch (Text, Omni)'
  printf '  %-14s %-20s %s\n' 'balanced'       'Vulkan/Vulkan/CPU' '2048/512, 2048/512; threads 2/2/2'
  printf '  %-14s %-20s %s\n' 'fastest'        'Vulkan/Vulkan/CPU' '512/128,   512/128; threads 4/4/4'
  printf '  %-14s %-20s %s\n' 'memory-saving'  'Vulkan/CPU/CPU'    '2048/256, 1024/256; threads 4/6/4'
}
set_preset() {
  local value="$1" temp
  valid_preset "$value" || { printf 'Unknown preset: %s\n' "$value" >&2; usage; return 2; }
  mkdir -p "$STATE_DIR"
  chmod 0700 "$STATE_DIR"
  temp="$(mktemp "$STATE_DIR/.preset.XXXXXXXX")"
  printf '%s\n' "$value" > "$temp"
  chmod 0600 "$temp"
  mv -f "$temp" "$PRESET_FILE"
  printf 'Selected LFM preset: %s (saved in %s)\n' "$value" "$PRESET_FILE"
  local -a active=()
  local model
  if command -v systemctl >/dev/null && [[ -f "$SYSTEMD_UNIT" ]]; then
    for model in "${MODELS[@]}"; do
      if systemctl --user is-active --quiet "lfm@$model.service"; then
        active+=("lfm@$model.service")
      fi
    done
    if (( ${#active[@]} )); then
      printf 'Restarting active models: %s\n' "${active[*]}"
      systemctl --user restart "${active[@]}"
    else
      echo 'No active model services; preset will apply at next start.'
    fi
  else
    echo 'Model services not set up; preset will apply at next start.'
  fi
}
preset_cli() {
  case "${1:-show}" in
    list) list_presets ;;
    show|current) selected_preset ;;
    *) set_preset "$1" ;;
  esac
}
setup() {
  if [[ ! -x "$SELF" ]]; then
    printf 'Install this script first: install -Dm755 ./lfm %q\n' "$SELF" >&2
    exit 1
  fi
  mkdir -p "$(dirname "$SYSTEMD_UNIT")"
  cat > "$SYSTEMD_UNIT" <<'UNIT'
[Unit]
Description=Local LFM %i model server (llama.cpp)
After=default.target

[Service]
Type=simple
ExecStart=%h/.bin/lfm serve %i
ExecStartPost=-%h/.bin/lfm warmup %i
TimeoutStartSec=1200
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  printf 'Installed %s\n' "$SYSTEMD_UNIT"
}
serve() {
  local target="$1" port model projector="" ngl=99 ctx batch ubatch
  local ctk=q4_0 ctv=q4_0 threads threads_batch fa=on poll=0 preset
  local -a args
  preset="$(selected_preset)" || return 2
  case "$target" in
    text)
      port=8081
      model="$MODEL_DIR/text/LFM3-1.7B-QAD-Q4_0.gguf"
      ctx=131072
      args=(--jinja --temp 0.1 --top-k 50 --repeat-penalty 1.1)
      ;;
    omni)
      port=8082
      model="$MODEL_DIR/omni/LFM3-Omni-2B-Q4_K_M.gguf"
      projector="$MODEL_DIR/omni/mmproj-LFM3-Omni-2B-Q4_K_M.gguf"
      ctx=32768
      args=(--jinja --temp 0 --reasoning off)
      ;;
    decision)
      port=8083
      model="$MODEL_DIR/decision/d1-omni-600M-Q8_0.gguf"
      projector="$MODEL_DIR/decision/mmproj-d1-omni-600M-Q8_0.gguf"
      ctx=1024; batch=1024; ubatch=1024; ngl=0
      # D1 scores choices in a single pass and has no autoregressive KV cache.
      args=()
      ;;
    *) usage; return 2 ;;
  esac
  # Exact settings from the benchmark's three selected configurations.
  case "$preset" in
    balanced)
      if [[ "$target" == decision ]]; then
        threads=2; threads_batch=2
      else
        batch=2048; ubatch=512; threads=2; threads_batch=4
      fi
      ;;
    fastest)
      if [[ "$target" == decision ]]; then
        threads=4; threads_batch=4
      else
        batch=512; ubatch=128; threads=4; threads_batch=4
      fi
      ;;
    memory-saving)
      case "$target" in
        text) batch=2048; ubatch=256; threads=4; threads_batch=6 ;;
        omni) ngl=0; batch=1024; ubatch=256; threads=6; threads_batch=6 ;;
        decision) threads=4; threads_batch=4 ;;
      esac
      ;;
  esac
  local -a mmproj=() cpu=() cmd
  [[ "$ngl" != 0 ]] || cpu=(--device none --no-kv-offload --no-op-offload)
  [[ -z "$projector" ]] || mmproj=(-mm "$projector")
  [[ "$ngl" != 0 || -z "$projector" ]] || mmproj+=(--no-mmproj-offload)
  cmd=("$SERVER" -m "$model" "${mmproj[@]}" "${cpu[@]}"
    --host "127.0.0.1,$SOCK_DIR/$target.sock" --port "$port"
    --alias "lfm-$target" -ngl "$ngl" --fit off -fa "$fa"
    -ctk "$ctk" -ctv "$ctv" -c "$ctx" -b "$batch" -ub "$ubatch"
    -t "$threads" -tb "$threads_batch" -np 1
    --poll "$poll" --poll-batch "$poll" "${args[@]}")
  if [[ "${2:-}" == preview ]]; then
    printf '%q ' "${cmd[@]}"; printf '\n'; return
  fi
  if [[ ! -x "$SERVER" ]]; then printf 'Missing server: %s\n' "$SERVER" >&2; return 1; fi
  if [[ ! -s "$model" ]]; then printf 'Missing model: %s\n' "$model" >&2; return 1; fi
  if [[ -n "$projector" && ! -s "$projector" ]]; then printf 'Missing projector: %s\n' "$projector" >&2; return 1; fi
  mkdir -p "$SOCK_DIR"
  chmod 0700 "$SOCK_DIR"
  rm -f "$SOCK_DIR/$target.sock"
  exec "${cmd[@]}"
}
# Assemble Pi's real startup system prompt and active tool schemas with the
# installed Pi SDK. No prompt is sent to Pi or any external API.
# LFM_PI_CWD sets the workspace whose AGENTS.md/.pi instructions are loaded.
# LFM_PI_SDK optionally points to Pi's package directory or dist/index.js.
# LFM_PI_BIN optionally locates the installed 'pi' CLI.
pi_warmup_payload() {
  command -v node >/dev/null || { echo 'Pi warmup requires Node.js' >&2; return 1; }
  node --input-type=module <<'PISDK'
import { realpathSync, existsSync, readFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import { createRequire } from 'node:module';
import { execFileSync } from 'node:child_process';
const names = ['@mariozechner/pi-coding-agent', '@earendil-works/pi-coding-agent'];
const candidates = [];
const add = p => { if (p && !candidates.includes(p)) candidates.push(p); };
function packageEntry(root) {
  try {
    const j = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'));
    if (!names.includes(j.name)) return;
    const exp = j.exports?.['.'];
    const entry = (typeof exp === 'string' ? exp : exp?.import) || j.module || j.main || './dist/index.js';
    add(resolve(root, entry));
  } catch {}
}
function walk(path) {
  try {
    let dir = dirname(realpathSync(path));
    while (true) {
      packageEntry(dir);
      if (dir === dirname(dir)) break;
      dir = dirname(dir);
    }
  } catch {}
}
const explicit = process.env.LFM_PI_SDK;
if (explicit) {
  try {
    const p = realpathSync(explicit);
    if (p.endsWith('.js') || p.endsWith('.mjs')) add(p);
    else packageEntry(p);
  } catch {}
}
let piBin = process.env.LFM_PI_BIN;
if (!piBin) {
  try { piBin = execFileSync('sh', ['-c', 'command -v pi'], {encoding:'utf8'}).trim(); } catch {}
}
if (piBin) walk(piBin);
const roots = [process.cwd(), process.env.HOME, '/usr/lib/node_modules', '/usr/local/lib/node_modules'];
try { roots.push(execFileSync('npm', ['root', '-g'], {encoding:'utf8', timeout:5000}).trim()); } catch {}
for (const base of roots) {
  if (!base) continue;
  const from = createRequire(pathToFileURL(resolve(base, '_lfm_resolve.cjs')).href);
  for (const name of names) {
    try { add(from.resolve(name)); } catch {}
    packageEntry(join(base, name));
  }
}
let pi, lastError;
for (const file of candidates) {
  if (!existsSync(file)) continue;
  try {
    const mod = await import(pathToFileURL(file).href);
    if (typeof mod.createAgentSession === 'function') { pi = mod; break; }
  } catch (e) { lastError = e; }
}
if (!pi) throw new Error('Pi SDK not found. Set LFM_PI_SDK to the installed Pi package directory' + (lastError ? ': ' + lastError.message : ''));
const { createAgentSession, SessionManager } = pi;
const options = { cwd: process.env.LFM_PI_CWD || process.env.HOME || process.cwd() };
if (SessionManager?.inMemory) options.sessionManager = SessionManager.inMemory();
const { session } = await createAgentSession(options);
try {
  const prompt = session.systemPrompt || session.agent?.state?.systemPrompt;
  if (typeof prompt !== 'string' || !prompt.trim()) throw new Error('Pi SDK did not expose a populated system prompt');
  const active = typeof session.getActiveToolNames === 'function' ? new Set(session.getActiveToolNames()) : null;
  const tools = (session.agent?.state?.tools || [])
    .filter(t => !active || active.has(t.name))
    .map(t => ({ type:'function', function:{
      name:t.name, description:t.description || '',
      parameters:t.parameters || {type:'object', properties:{}}
    }}));
  // Last user message is intentionally short; cache reuse depends on Pi sending
  // an identical system/tool prefix on its first real request.
  const result = { messages:[{role:'system', content:prompt}, {role:'user', content:'Ready.'}] };
  if (tools.length) { result.tools = tools; result.tool_choice = 'auto'; }
  process.stdout.write(JSON.stringify(result));
} finally {
  session.dispose();
}
PISDK
}
# Text warms Pi's assembled system/tool prefix. A caller may supply an explicit
# warmup JSON path via LFM_TEXT_PREWARM_JSON, but no ~/.config path is consulted.
# If SDK resolution fails, we do not silently claim Pi cache warming succeeded.
warmup() {
  local target="$1" port request
  case "$target" in
    text) port=8081 ;;
    omni) port=8082 ;;
    decision) port=8083 ;;
    *) usage; return 2 ;;
  esac
  [[ "${LFM_PREWARM:-1}" != 0 ]] || return 0
  local filename_var="LFM_${target^^}_PREWARM_JSON"
  request="${!filename_var:-}"
  local temp_request="" rc=0
  if [[ "$target" == text && "${LFM_PI_AUTO_WARMUP:-1}" != 0 ]]; then
    mkdir -p "$SOCK_DIR"; chmod 0700 "$SOCK_DIR"
    temp_request="$(mktemp "$SOCK_DIR/pi-text-warmup.XXXXXXXX.json")"
    if pi_warmup_payload > "$temp_request"; then
      request="$temp_request"
    elif [[ -n "$request" && -f "$request" ]]; then
      echo 'Pi SDK warmup unavailable; using explicitly supplied LFM_TEXT_PREWARM_JSON' >&2
    else
      echo 'Text warmup skipped: Pi prompt unavailable; set LFM_PI_SDK or LFM_TEXT_PREWARM_JSON' >&2
      rm -f "$temp_request"
      return 1
    fi
  fi
  if python3 - "$port" "$target" "$request" <<'PYWARM'
import json, sys, time, urllib.request, urllib.error
from pathlib import Path
port, target, filename = sys.argv[1:]
base = 'http://127.0.0.1:' + port
# Ignore proxy environment for local inference.
client = urllib.request.build_opener(urllib.request.ProxyHandler({}))
def call(path, payload=None, timeout=5):
    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(base + path, data=data,
                                 headers={'Content-Type': 'application/json'})
    with client.open(req, timeout=timeout) as response:
        result = json.load(response)
    if isinstance(result, dict) and 'error' in result:
        raise RuntimeError(str(result['error']))
    return result
try:
    deadline = time.monotonic() + 300
    while True:
        try:
            call('/health')
            break
        except (urllib.error.URLError, TimeoutError):
            if time.monotonic() >= deadline:
                raise RuntimeError('server readiness timeout')
            time.sleep(1)
    path = Path(filename)
    if target == 'decision':
        # d1-omni-600M is a single-pass decision model, not a chat generator.
        # The API expects a state and typed questions, and produces zero tokens.
        if filename and path.is_file():
            payload = json.loads(path.read_text())
            if not isinstance(payload, dict) or 'state' not in payload or not isinstance(payload.get('questions'), dict):
                raise ValueError('decision prewarm must contain state and questions for /v1/systemone')
            kind = 'saved decision request'
        else:
            payload = {'state': 'Please examine this short routing request.',
                       'questions': {'route': {'type': 'choice',
                                               'instructions': 'Which route fits this request?',
                                               'criteria': {'text': None, 'omni': None}}}}
            kind = 'runtime decision warmup'
        result = call('/v1/systemone', payload, timeout=850)
    else:
        if filename and path.is_file():
            payload = json.loads(path.read_text())
            if not isinstance(payload, dict) or not isinstance(payload.get('messages'), list):
                raise ValueError('prewarm JSON must be a chat request with messages')
            kind = 'Pi system prompt / saved prompt prefix' if target == 'text' else 'saved prompt prefix'
        else:
            payload = {'messages': [{'role': 'user', 'content': 'Hello'}]}
            kind = 'runtime only; no saved Pi prompt'
        # Never execute returned tool calls. Bound warmup generation to one token.
        payload.pop('max_completion_tokens', None)
        payload.pop('n_predict', None)
        payload.update(model='lfm-' + target, stream=False, max_tokens=1,
                       n=1, cache_prompt=True)
        result = call('/v1/chat/completions', payload, timeout=850)
    print('LFM warmup complete:', target, '(' + kind + ')',
          'usage=' + json.dumps(result.get('usage', {})), flush=True)
except Exception as exc:
    print('LFM warmup failed for ' + target + ': ' + str(exc), file=sys.stderr)
    sys.exit(1)
PYWARM
  then
    rc=0
  else
    rc=$?
  fi
  [[ -z "$temp_request" ]] || rm -f "$temp_request"
  return "$rc"
}
# Probe actual running servers. Pi's contextWindow is only client metadata:
# the authoritative context limit is llama.cpp's /props n_ctx.
doctor() {
  printf 'Active preset: %s\n' "$(selected_preset)"
  python3 - <<'PYDOCTOR'
import json, urllib.request, urllib.error
models = [('text', 8081, 'lfm-text', 131072),
          ('omni', 8082, 'lfm-omni', 32768),
          ('decision', 8083, 'lfm-decision', 1024)]
client = urllib.request.build_opener(urllib.request.ProxyHandler({}))
def get(port, path):
    req = urllib.request.Request(f'http://127.0.0.1:{port}{path}')
    with client.open(req, timeout=2.5) as response:
        return json.load(response)
print(f'{"model":<9} {"port":<6} {"expected":>9} {"running":>9}  {"server alias":<22} status')
errors = 0
for name, port, expected_alias, expected_ctx in models:
    try:
        props = get(port, '/props')
        model_list = get(port, '/v1/models')
        aliases = [str(m.get('id', '')) for m in model_list.get('data', [])]
        actual_alias = ','.join(aliases) or '(unknown)'
        actual_ctx = props.get('default_generation_settings', {}).get('n_ctx')
        if actual_ctx is None: actual_ctx = props.get('n_ctx')
        notes = []
        if expected_alias not in aliases: notes.append('ALIAS MISMATCH')
        if isinstance(actual_ctx, int) and actual_ctx != expected_ctx: notes.append('CTX MISMATCH')
        if actual_ctx is None: notes.append('ctx unavailable')
        status = 'OK' if not notes else '; '.join(notes)
        print(f'{name:<9} {port:<6} {expected_ctx:>9} {str(actual_ctx):>9}  {actual_alias:<22} {status}')
        if 'MISMATCH' in status: errors += 1
    except Exception as exc:
        print(f'{name:<9} {port:<6} {expected_ctx:>9} {"offline":>9}  {"-":<22} {str(exc)[:65]}')
        # It is valid to have only some model services active on memory-constrained hosts.
if errors:
    print('Inspect: lfm preset show; lfm command text; lfm command omni')
    raise SystemExit(1)
PYDOCTOR
}
valid_target() {
  case "$1" in text|omni|decision|all) ;; *) usage; exit 2 ;; esac
}
run_for() {
  local verb="$1" target="$2" m
  valid_target "$target"
  local -a targets=("$target")
  [[ "$target" == all ]] && targets=("${MODELS[@]}")
  for m in "${targets[@]}"; do
    if [[ "$verb" == status ]]; then
      printf '%-9s %-12s http://127.0.0.1:%s %s\n' "$m" "$(systemctl --user is-active "lfm@$m.service" 2>/dev/null || true)" \
        "$(case "$m" in text) echo 8081;; omni) echo 8082;; decision) echo 8083;; esac)" "$SOCK_DIR/$m.sock"
    else
      printf '%s %s\n' "$verb" "$m"
      systemctl --user "$verb" "lfm@$m.service"
    fi
  done
}
command="${1:-}"; target="${2:-all}"
case "$command" in
  preset|--preset) preset_cli "${2:-show}" ;;
  setup) setup ;;
  warmup) warmup "${2:-text}" ;;
  command) serve "${2:-text}" preview ;;
  doctor) doctor ;;
  serve) serve "${2:?model required}" ;;
  start|stop|restart|status|enable|disable)
    [[ -f "$SYSTEMD_UNIT" || "$command" == status ]] || setup
    run_for "$command" "$target" ;;
  switch)
    target="${2:-text}"; valid_target "$target"
    [[ -f "$SYSTEMD_UNIT" ]] || setup
    run_for stop all
    run_for start "$target" ;;
  logs)
    target="${2:-text}"; valid_target "$target"
    if [[ "$target" == all ]]; then
      journalctl --user -u 'lfm@*.service' -n 100 --no-pager
    else
      journalctl --user -u "lfm@$target.service" -n 100 --no-pager
    fi ;;
  help|-h|--help|'') usage ;;
  *) usage; exit 2 ;;
esac
