def now(): return datetime.now(timezone.utc).isoformat()
def dump(p, obj):
    p = Path(p); tmp=p.with_suffix(p.suffix+'.tmp')
    with tmp.open('w') as f:
        json.dump(obj,f,indent=2,ensure_ascii=False); f.write('\n'); f.flush(); os.fsync(f.fileno())
    tmp.replace(p)
def digest(p):
    h=hashlib.sha256()
    with Path(p).open('rb') as f:
        for b in iter(lambda:f.read(1024*1024),b''): h.update(b)
    return h.hexdigest()
def fingerprint(x): return hashlib.sha256(json.dumps(x,sort_keys=True).encode()).hexdigest()
def read_rows(p):
    rows=[]
    if Path(p).exists():
        data=Path(p).read_bytes(); lines=data.splitlines(keepends=True)
        for i,line in enumerate(lines):
            try: rows.append(json.loads(line))
            except (ValueError,UnicodeError):
                if i!=len(lines)-1 or line.endswith(b'\n'): raise ValueError(f'Corrupt JSONL: {p}, line {i+1}')
                # A crash can leave one incomplete final append. Truncate only that tail.
                with Path(p).open('r+b') as f: f.truncate(sum(map(len,lines[:i])))
    return rows

class APIError(Exception): pass
class UnixConnection(http.client.HTTPConnection):
    def __init__(self,path,timeout): super().__init__('localhost',timeout=timeout); self.path=str(path)
    def connect(self):
        self.sock=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout); self.sock.connect(self.path)

class API:
    def __init__(self,opts,emit=None): self.o=opts; self.emit=emit
    def connection(self,role,transport=None):
        if (transport or self.o.transport)=='unix':
            return UnixConnection(Path(os.environ.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))/'lfm'/f'{role}.sock',self.o.timeout)
        return http.client.HTTPConnection('127.0.0.1',PORTS[role],timeout=self.o.timeout)
    def call(self,role,endpoint,payload=None,transport=None,stream=False,context=None):
        c=self.connection(role,transport); start=time.perf_counter(); first=None; visible=None
        try:
            c.request('GET' if payload is None else 'POST',endpoint,
                      None if payload is None else json.dumps(payload).encode(),{'Content-Type':'application/json'})
            r=c.getresponse()
            if r.status>=400: raise APIError(f'{role} HTTP {r.status}: {r.read(2048).decode(errors="replace")}')
            if not stream: response=json.loads(r.read())
            else:
                text=''; reasoning=''; calls={}; finish=None; usage={}; timings={}; last={}
                for line in iter(r.readline,b''):
                    if not line.startswith(b'data:'): continue
                    data=line[5:].strip()
                    if data==b'[DONE]': break
                    e=json.loads(data); last=e
                    if 'error' in e: raise APIError(str(e['error']))
                    usage=e.get('usage') or usage; timings=e.get('timings') or timings
                    for choice in e.get('choices',[]):
                        d=choice.get('delta',{}); t=time.perf_counter()-start
                        if first is None and any(d.get(k) for k in ('content','reasoning_content','tool_calls')): first=t
                        if visible is None and d.get('content'): visible=t
                        text+=d.get('content') or ''; reasoning+=d.get('reasoning_content') or ''
                        finish=choice.get('finish_reason') or finish
                        for call in d.get('tool_calls') or []:
                            idx=call.get('index',0); dest=calls.setdefault(idx,{'id':'','type':'function','function':{'name':'','arguments':''}})
                            if call.get('id'): dest['id']=call['id']
                            for key in ('name','arguments'):
                                v=call.get('function',{}).get(key)
                                if v is not None: dest['function'][key]+=v if isinstance(v,str) else json.dumps(v)
                        if self.emit and (d.get('content') or d.get('reasoning_content')):
                            self.emit('delta',dict(context or {},role=role,content=d.get('content'),reasoning=d.get('reasoning_content')))
                msg={'role':'assistant','content':text,'reasoning_content':reasoning}
                if calls: msg['tool_calls']=[calls[k] for k in sorted(calls)]
                response={'choices':[{'message':msg,'finish_reason':finish}],'usage':usage,'timings':timings,
                          'model':last.get('model'),'system_fingerprint':last.get('system_fingerprint')}
            if 'error' in response: raise APIError(str(response['error']))
            return response,{'latency_s':time.perf_counter()-start,'first_generated_token_s':first,
                             'first_visible_token_s':visible,'streamed':stream}
        except (OSError,ValueError,http.client.HTTPException) as e: raise APIError(f'{role}: {e}') from e
        finally: c.close()
    def chat(self,role,messages,thinking,tools=None,context=None,max_tokens=None):
        p={'model':'lfm-'+role,'messages':messages,'temperature':0,'seed':self.o.seed,
           'max_tokens':max_tokens or self.o.max_tokens,'stream':True,'stream_options':{'include_usage':True},
           'cache_prompt':True}
        if role=='text': p['chat_template_kwargs']={'enable_thinking':bool(thinking)}
        if tools: p.update(tools=TOOLS,tool_choice='auto')
        r,m=self.call(role,'/v1/chat/completions',p,stream=True,context=context)
        return r,m,p
    def decision(self,prompt,attachment=None):
        # Attachment type is metadata, not an oracle route; no second classifier call.
        state=prompt
        if len(state)>self.o.decision_max_chars:
            half=self.o.decision_max_chars//2
            state=state[:half]+'\n[Middle omitted to fit 1K classifier context; chat receives the full original request.]\n'+state[-half:]
        state+=(f'\nAn actual {attachment} attachment is provided.' if attachment else '')
        p={'state':state,'questions':{
            'route':{'type':'choice','instructions':'Choose the handler for the user request.',
                     'criteria':{'direct':'Answer using text knowledge, no external tools needed',
                                 'tool':'Must retrieve current system, network or fixture data using tools',
                                 'media':'Must inspect an attached image, screenshot, audio or video'}},
            'needs_tool':{'type':'noul','instructions':'Does the request require calling a system or network tool to fetch facts, rather than just explaining something?'},
            'reasoning':{'type':'noul','instructions':'Does this require extended reasoning: complex troubleshooting, debugging code, dependent multi-step orchestration, or a difficult logical problem? Simple facts and a straightforward single tool lookup do not.'}}}
        r,m=self.call('decision','/v1/systemone',p); return r,m,p

def visible_message(r):
    try: msg=r['choices'][0]['message']; content=msg.get('content') or ''
    except (KeyError,IndexError,TypeError) as e: raise APIError('Malformed chat response') from e
    leaked='</think>' in content or '<think>' in content
    if '</think>' in content: content=content.rsplit('</think>',1)[1]
    elif '<think>' in content: content=''
    return msg,content.strip(),leaked

def choose(r,o):
    a=r.get('answers',{}); route=a.get('route',{}).get('choice'); conf=a.get('route',{}).get('confidence',0)
    tool=a.get('needs_tool',{}).get('noul'); score=a.get('reasoning',{}).get('noul')
    if route not in ('direct','tool','media') or not isinstance(tool,(int,float)) or not isinstance(score,(int,float)):
        raise APIError('Invalid unified classifier response')
    ambiguous=abs(score-o.thinking_threshold)<o.ambiguity_margin
    thinking=(o.fallback=='on') if ambiguous else score>=o.thinking_threshold
    return {'route':route,'needs_tool':route=='tool' or tool>=o.tool_threshold,
            'raw_tool_prediction':tool>=o.tool_threshold,'route_tool_disagreement':(route=='tool')!=(tool>=o.tool_threshold),
            'thinking':thinking,'thinking_score':score,
            'tool_score':tool,'route_confidence':conf,'ambiguous_reasoning':ambiguous,
            'probabilities':a.get('route',{}).get('probabilities')}

def tool_execute(task,name,args):
    f=task['fixture']
    if name=='get_system_info' and args=={}: return {'kernel':f['kernel'],'load':f['load'],'host':f['host'],'simulated':True}
    if name=='get_network_info' and args=={}: return {'interface':f['interface'],'ipv4':f['ip'],'simulated':True}
    if name=='probe_tcp_port' and args=={'host':f['host'],'port':f['port']}:
        return {'error':'connection refused','simulated':True} if f['failed'] else {'reachable':True,'rtt_ms':f['rtt'],'simulated':True}
    return {'error':'invalid fixture tool or arguments','simulated':True}

def generate(o,media):
    rng=random.Random(o.seed); tasks=[]
    categories=['linux','explanation','summary','extraction','coding','troubleshooting','reasoning',
                'single_system','single_network','dependent_tools','parallel_tools','tool_failure','gating','long_context','mixed']
    if getattr(o,'quick',False): categories=['summary','extraction','coding','reasoning','single_network']
    if o.tools: categories=['single_system','single_network','dependent_tools','parallel_tools','tool_failure','gating']
    if o.mixed: categories=['mixed']
    if o.media: categories=[]
    if o.prompt: categories=['custom']
    used=set()
    for i in range(o.samples):
        for category in categories:
            a=rng.randint(10,899); b=rng.randint(10,899); tag=f'{i:03d}-{rng.randrange(10**8):08d}'
            fixture={'kernel':f'6.{rng.randrange(1,20)}.{rng.randrange(1,99)}-fixture-{tag}',
                     'load':round(rng.random()*3,2),'host':f'node-{tag}.example.invalid','port':rng.choice([443,8443,8080]),
                     'interface':f'eth{rng.randrange(1,9)}','ip':f'192.0.2.{rng.randrange(1,254)}',
                     'failed':category=='tool_failure','rtt':rng.randrange(1,20)}
            expected=[]; checks=[]; thinking=False; route='direct'; kind='contains'; cat=category
            if category=='mixed': cat=['reasoning','single_system','dependent_tools','summary'][i%4]
            if cat=='linux':
                topic,answer=rng.choice([('command that prints the kernel release','uname -r'),('absolute directory containing process information','/proc'),('command that prints the current directory','pwd'),('command to resolve a symbolic link','readlink')])
                prompt=f'Ticket {tag}: Give the {topic}. No tools; general knowledge only.'; checks=[answer]
            elif cat=='explanation':
                x,y=rng.choice([('VRAM versus GTT','shared'),('symbolic versus hard links','inode'),('TCP versus UDP','connection'),('swap versus RAM','disk')])
                prompt=f'Teaching note {tag}: Explain {x} in two short sentences. Include the term {y}.'; checks=[y]
            elif cat=='summary':
                prompt=f'Summarize this incident in one sentence retaining the ticket and outcome: ticket {tag}; retries {a}; service restored after {b} seconds; no data lost.'; checks=[tag,'restored',str(b)]
            elif cat=='extraction':
                prompt=f'Extract this as a JSON object, no prose: ticket={tag}, retries={a}, elapsed={b}. Keys: ticket, retries, elapsed.'
                kind='json'; checks={'ticket':tag,'retries':a,'elapsed':b}
            elif cat=='coding':
                prompt=f'Debug Python: def f(x): return x + {a}\nExpected f({b}) to multiply x by {a}, not add. Give only the corrected return statement.'
                checks=['return',str(a),'*']; thinking=True
            elif cat=='troubleshooting':
                prompt=f'Incident {tag}: DNS resolves node to 192.0.2.5; ping succeeds; TCP port {a+1000} returns connection refused immediately. Is DNS failure or no listening service the better explanation? Explain briefly without tools.'
                checks=['listen']; thinking=True
            elif cat=='reasoning':
                prompt=f'A fixture starts with {a} jobs, completes {b} jobs and receives {b+7} more. What is the final job count? Output only the integer.'
                checks=[str(a+7)]; kind='integer'; thinking=True
            elif cat=='long_context':
                target=f'KEY-{tag}'; entries=[f'item {j}: value {rng.randrange(100000)}' for j in range(o.context_lines)]
                entries.insert(rng.randrange(len(entries)+1),f'TARGET = {target}')
                prompt='Read the ledger and return only the TARGET value.\n'+'\n'.join(entries); checks=[target]
            elif cat in ('single_system','single_network','dependent_tools','parallel_tools','tool_failure'):
                route='tool'
                if cat=='single_system':
                    prompt=f'Ticket {tag}: Fetch the current simulated kernel and load using get_system_info, and report both.'
                    expected=[['get_system_info',{}]]; checks=[fixture['kernel'],str(fixture['load'])]
                elif cat in ('single_network','tool_failure'):
                    prompt=f'Ticket {tag}: Use probe_tcp_port to check {fixture["host"]}:{fixture["port"]}. Report whether the simulated connection succeeds or fails.'
                    expected=[['probe_tcp_port',{'host':fixture['host'],'port':fixture['port']}]]
                    checks=['refused'] if fixture['failed'] else ['reachable']
                elif cat=='dependent_tools':
                    prompt=f'Ticket {tag}: First get_system_info to discover the recommended host. Then probe_tcp_port on that returned host at port {fixture["port"]}. Report the kernel and reachability. Do not guess the host.'
                    expected=[['get_system_info',{}],['probe_tcp_port',{'host':fixture['host'],'port':fixture['port']}]]
                    checks=[fixture['kernel'],'reachable']; thinking=True
                else:
                    prompt=f'Ticket {tag}: Fetch get_system_info and get_network_info, preferably in parallel, and report the kernel and IP.'
                    expected=[['get_system_info',{}],['get_network_info',{}]]; checks=[fixture['kernel'],fixture['ip']]; thinking=True
            elif cat=='gating':
                prompt=f'Ticket {tag}: Explain how one could check TCP port {fixture["port"]} in principle. Do NOT check any host or use any tools.'; checks=[str(fixture['port'])]
            else: prompt=o.prompt; kind='review'
            task={'category':category,'variant':cat,'prompt':prompt,'fixture':fixture,'expected_calls':expected,
                  'expected_route':route,'expected_thinking':thinking,'checks':checks,'scorer':kind,'media':None,
                  'concurrent':category=='mixed','replicate':i}
            # Same underlying question with a ticket only is NOT an independent knowledge sample.
            task['independence_note']='Generated fixture/argument instance; template-level correlations remain.'
            task['independent_unit']=(category+':'+fingerprint(prompt.replace(tag,'<ticket>'))) if category in ('linux','explanation') else category+':'+tag
            h=fingerprint(task)
            if h in used: continue
            used.add(h); task['id']=f'{category}-{i:03d}-{h[:10]}'; task['input_hash']=h; tasks.append(task)
    if not o.tools and not o.prompt and not getattr(o,'quick',False):
        for m in media:
            if not m.get('usable'): continue
            task={'category':'media','variant':m['kind'],'prompt':('Transcribe or describe the attached media briefly. Do not invent details. '
                  'The description will be summarized into one sentence.'),'media':m,'fixture':{},'expected_calls':[],
                  'expected_route':'media','expected_thinking':False,'checks':[],'scorer':'review','concurrent':False,
                  'independence_note':'One independent source file; repetitions are not independent media samples.'}
            task['independent_unit']='media:'+m['sha256']
            task['input_hash']=fingerprint(task); task['id']='media-'+task['input_hash'][:12]; tasks.append(task)
    if o.smoke:
        keep=('reasoning','single_system','dependent_tools','mixed','media')
        tasks=[t for t in tasks if t['category'] in keep][:8]
    rng.shuffle(tasks)
    modes=['on','off','adaptive'] if o.reasoning=='compare' else [o.reasoning]
    # Random permutation per independent task, persisted exactly for resume.
    for task in tasks: task['mode_order']=rng.sample(modes,len(modes))
    return tasks

def media_discover(o):
    rng=random.Random(o.seed ^ 0x4d45444941); selected={}; counts={}; errors=[]
    extkind={e:k for k,es in FORMATS.items() for e in es}
    paths=[Path(o.image_file).expanduser()] if o.image_file else None
    def files():
        if paths: yield from paths; return
        for root,dirs,names in os.walk(Path(o.media_root).expanduser(),followlinks=False,onerror=lambda e:errors.append(str(e))):
            # Scan hidden directories too, but avoid benchmark-generated copies and symlinks.
            dirs[:]=sorted(d for d in dirs if d!='.git' and not (Path(root)/d).is_symlink() and Path(root)/d!=ROOT)
            for name in sorted(names): yield Path(root)/name
    for p in files():
        ext=p.suffix.lower().lstrip('.')
        if ext not in extkind or p.is_symlink(): continue
        try:
            size=p.stat().st_size
            if not p.is_file() or not 0<size<=o.max_media_mb*1024*1024: continue
        except OSError: continue
        counts[ext]=counts.get(ext,0)+1
        if rng.randrange(counts[ext])==0: selected[ext]=p
    result=[]
    for ext in sorted(extkind):
        p=selected.get(ext); row={'format':ext,'kind':extkind[ext],'eligible_count':counts.get(ext,0),'usable':False}
        if p:
            row.update(path=str(p),bytes=p.stat().st_size,sha256=digest(p),input_path=str(p),conversion=None)
            if extkind[ext]!='image':
                try:
                    q=subprocess.run(['ffprobe','-v','error','-show_entries','format=duration','-of','json',str(p)],capture_output=True,text=True,timeout=20,check=True)
                    row['duration_s']=float(json.loads(q.stdout)['format']['duration'])
                    if row['duration_s']>o.max_media_seconds: row['skip_reason']='Selected original exceeds duration limit; no silent substitute.'
                except (OSError,ValueError,KeyError,subprocess.SubprocessError): row['skip_reason']='Duration cannot be verified (ffprobe missing or invalid media).'
            if 'skip_reason' not in row: row['usable']=True
        else: row['skip_reason']='No eligible file found within size limit.'
        result.append(row)
    return result,errors

def media_part(m):
    p=Path(m['input_path'])
    if digest(p)!=m.get('input_sha256',m['sha256']): raise APIError('Media content changed since manifest; refusing substitution')
    mime=mimetypes.guess_type(str(p))[0] or {'image':'image/png','audio':'audio/wav','video':'video/mp4'}[m['kind']]
    uri='data:'+mime+';base64,'+base64.b64encode(p.read_bytes()).decode()
    if m['kind']=='image': return {'type':'image_url','image_url':{'url':uri}}
    key='input_'+m['kind']; return {'type':key,key:{'data':uri}}

class Sampler:
    def __init__(self,engine): self.e=engine; self.stop=threading.Event(); self.thread=threading.Thread(target=self.run,daemon=True)
    def run(self):
        while not self.stop.is_set():
            t=time.perf_counter(); row={'utc':now(),'time':time.time(),'gpu':{},'processes':{}}
            for dev in Path('/sys/class/drm').glob('card[0-9]*/device'):
                g={}
                for name in ('mem_info_vram_used','mem_info_gtt_used','mem_info_vram_total','mem_info_gtt_total','gpu_busy_percent','pp_dpm_sclk','pp_dpm_mclk'):
                    try:
                        val=(dev/name).read_text().strip(); g[name]=int(val) if val.isdigit() else val
                    except OSError: pass
                for hw in (dev/'hwmon').glob('hwmon*'):
                    for p in hw.glob('*_input'):
                        if p.name.startswith(('temp','power','fan')):
                            try:g[p.name]=int(p.read_text())
                            except (OSError,ValueError): pass
                if g: row['gpu'][str(dev)]=g
            try:
                row['meminfo_kib']={k:int(v.split()[0]) for k,v in (line.split(':',1) for line in Path('/proc/meminfo').read_text().splitlines()) if k in ('MemTotal','MemAvailable','SwapTotal','SwapFree','Cached')}
                row['cpu_stat']=Path('/proc/stat').read_text().splitlines()[0];row['loadavg']=Path('/proc/loadavg').read_text().strip()
            except OSError: pass
            for pid in self.e.pids:
                try:
                    stat=Path(f'/proc/{pid}/stat').read_text().rsplit(')',1)[1].split()
                    row['processes'][str(pid)]={'minor_faults':int(stat[7]),'major_faults':int(stat[9]),'utime_ticks':int(stat[11]),'stime_ticks':int(stat[12]),'rss_pages':int(stat[21])}
                except (OSError,ValueError,IndexError): pass
            row['sampling_seconds']=time.perf_counter()-t; self.e.append('system.jsonl',row)
            self.stop.wait(self.e.o.sample_interval)
    def start(self): self.thread.start()
    def close(self): self.stop.set(); self.thread.join(timeout=5)

def metadata(api):
    out={'utc':now(),'python':sys.version,'platform':os.uname()._asdict() if hasattr(os.uname(),'_asdict') else list(os.uname()),
         'tool_schemas':TOOLS,'servers':{},'processes':{},'monitoring_notes':
         ['DRM VRAM and GTT are distinct global counters, including desktop and other GPU clients.',
          'On an iGPU VRAM is firmware-reserved system memory, not separate physical GPU RAM.',
          'No cold-cache flush, service restart, or loading-time measurement is performed.',
          'Reasoning/visible token counts are null unless server exposes separate counts.',
          'Power, clocks and temperature only when exposed by readable sysfs. No inferred throttling claims.']}
    for role in PORTS:
        try: out['servers'][role]=api.call(role,'/props')[0]
        except APIError as e: out['servers'][role]={'error':str(e)}
    for proc in Path('/proc').glob('[0-9]*'):
        try:
            args=(proc/'cmdline').read_bytes().split(b'\0'); argv=[a.decode(errors='replace') for a in args if a]
            if not argv or Path(argv[0]).name!='llama-server':continue
            models=[]
            for flag in ('-m','-mm','--model','--mmproj'):
                if flag in argv:
                    p=Path(argv[argv.index(flag)+1]); st=p.stat()
                    models.append({'path':str(p),'bytes':st.st_size,'mtime_ns':st.st_mtime_ns,
                                   'identifier':p.name+';size='+str(st.st_size)+';mtime_ns='+str(st.st_mtime_ns)})
            out['processes'][proc.name]={'argv':argv,'models':models}
        except (OSError,ValueError,IndexError):pass
    for name,argv in [('llama_version',['/usr/local/bin/llama-server','--version']),
                      ('gpu_devices',['/usr/local/bin/llama-server','--list-devices']),('ffmpeg_version',['ffmpeg','-version']),
                      ('llama_git',['git','-C',str(Path.home()/'src/llama.cpp'),'rev-parse','HEAD'])]:
        try:
            q=subprocess.run(argv,capture_output=True,text=True,timeout=10);out[name]=(q.stdout+q.stderr)[:4000]
        except (OSError,subprocess.SubprocessError) as e:out[name]=str(e)
    return out

class Engine:
    def __init__(self,o,run):
        self.o=o; self.run=run; self.lock=threading.Lock(); self.api=API(o,self.event);self.pids=[]
        self.key=None
    def append(self,name,obj):
        with self.lock:
            with (self.run/name).open('a') as f:
                f.write(json.dumps(obj,ensure_ascii=False)+'\n');f.flush()
                if name not in ('events.jsonl','system.jsonl'):os.fsync(f.fileno())
    def event(self,kind,data):
        self.append('events.jsonl',{'utc':now(),'event':kind,**data})
        if not self.o.live:return
        if kind=='delta':
            value=data.get('content') or (data.get('reasoning') if self.o.show_reasoning else None)
            if value: print(value,end='',flush=True)
        else: print('\n['+kind+'] '+json.dumps(data,ensure_ascii=False),flush=True)
    def request_record(self,context,role,stage,p,r,m):
        # Do not duplicate large base64 inputs; hashes in media manifest identify exact bytes.
