            think=mode=='on' or (mode=='adaptive' and d['thinking']);row['thinking']=think
            self.event('decision',{**ctx,**d,'effective_thinking':think})
            msgs=[{'role':'system','content':SYSTEM},{'role':'user','content':task['prompt']}]
            final=''; all_r=[]; tool_s=0; args_ok=True; dependent_ok=True; media_complete=None
            # Intentional background contention: one extra Omni and d1 request only in mixed tasks.
            with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
                bg=[]
                if task['concurrent']:
                    bg=[pool.submit(self.api.call,'decision','/v1/systemone',{'state':'Explain Linux.','questions':{'tool':{'type':'noul','instructions':'Is a tool needed?'}}}),
                        pool.submit(self.api.chat,'omni',[{'role':'user','content':'Say ready.'}],False,None,ctx,32)]
                if d['route']=='media':
                    if not task['media']: raise ValueError('Router selected media without attachment')
                    t=time.perf_counter();part=media_part(task['media']);row['media_prepare_s']=time.perf_counter()-t
                    mr=self.chat('omni',[{'role':'system','content':'Respond briefly in text, only describe visible or audible evidence.'},
                          {'role':'user','content':[{'type':'text','text':task['prompt']},part]}],False,False,ctx,'media')
                    all_r.append(mr);_,recognition,_=visible_message(mr);media_complete=bool(recognition)
                    if not recognition:raise ValueError('Empty Omni recognition')
                    self.event('media-output',{**ctx,'recognition':recognition})
                    msgs=[{'role':'system','content':SYSTEM},{'role':'user','content':'Summarize the following media analysis in one sentence without adding facts:\n'+recognition}]
                tool_enabled=d['needs_tool'] and d['route']!='media'
                for hop in range(self.o.max_hops):
                    if STOP.is_set():raise InterruptedError('Interrupted between inference requests')
                    rr=self.chat('text',msgs,think,tool_enabled,ctx,f'text-hop-{hop}')
                    all_r.append(rr);msg,final,leaked=visible_message(rr)
                    calls=msg.get('tool_calls') or []
                    if not calls:break
                    assistant={'role':'assistant','content':msg.get('content') or '', 'tool_calls':json.loads(json.dumps(calls))}
                    if msg.get('reasoning_content'):assistant['reasoning_content']=msg['reasoning_content']
                    # Installed LFM template expects parsed object arguments in history.
                    for c in assistant['tool_calls']:
                        raw=c['function'].get('arguments') or '{}'
                        c['function']['arguments']=json.loads(raw) if isinstance(raw,str) else raw
                    msgs.append(assistant)
                    seen_before=[c['name'] for c in row['calls']]
                    for c in assistant['tool_calls']:
                        name=c['function']['name'];args=c['function']['arguments']
                        if not isinstance(args,dict):raise ValueError('Tool arguments are not an object')
                        if task['variant']=='dependent_tools' and name=='probe_tcp_port' and 'get_system_info' not in seen_before:dependent_ok=False
                        tt=time.perf_counter();result=tool_execute(task,name,args);elapsed=time.perf_counter()-tt;tool_s+=elapsed
                        if result.get('error')=='invalid fixture tool or arguments':args_ok=False
                        row['calls'].append({'name':name,'arguments':args,'result':result,'execution_s':elapsed,'hop':hop})
                        self.event('tool',{**ctx,**row['calls'][-1]})
                        msgs.append({'role':'tool','tool_call_id':c['id'],'content':json.dumps(result)})
                else:raise ValueError('Tool hop limit reached')
                for idx,f in enumerate(bg):
                    result=f.result()
                    if idx==0:br,bm=result;bp={'state':'Explain Linux.','questions':{'tool':{'type':'noul','instructions':'Is a tool needed?'}}};role='decision'
                    else:br,bm,bp=result;role='omni'
                    self.request_record(ctx,role,'contention-background',bp,br,bm)
                    row.setdefault('contention_background_s',[]).append(bm['latency_s'])
            got=[[c['name'],c['arguments']] for c in row['calls']];expected=task['expected_calls']
            if task['variant']=='parallel_tools': calls_correct=sorted(map(json.dumps,got))==sorted(map(json.dumps,expected))
            else:calls_correct=got==expected
            score=score_answer(task,final)
            row.update(final_answer=final,answer_correct=score,calls_correct=calls_correct,arguments_correct=args_ok,
                       dependent_order_correct=dependent_ok,tool_execution_s=tool_s,media_handoff_complete=media_complete,
                       unnecessary_calls=max(0,len(got)-len(expected)),missed_calls=max(0,len(expected)-len(got)),
                       format_correct=(final.strip()==task['checks'][0]) if task['scorer']=='integer' else None,
                       success=bool(final) and score is not False and calls_correct and args_ok and dependent_ok and row['route_correct'])
            for rr in all_r:
                row['completion_tokens']+=(rr.get('usage') or {}).get('completion_tokens',0)
                row['length_terminations']+=rr['choices'][0].get('finish_reason')=='length'
            if row['length_terminations']:row['success']=False
            self.event('answer',{**ctx,'answer':final,'success':row['success'],'scored':row['scored']})
        except InterruptedError:raise
        except (APIError,OSError,ValueError,KeyError,TypeError) as e:
            row['error']=f'{type(e).__name__}: {e}';row['infrastructure_error']=isinstance(e,(APIError,OSError))
            self.event('error',{**ctx,'error':row['error']})
        row['latency_s']=time.perf_counter()-start
        self.append('results.jsonl',row)
        if row['error']:self.append('errors.jsonl',row)
        print(f"{task['id']} {mode:8} {'PASS' if row['success'] else 'FAIL'} {row['latency_s']:.2f}s tokens={row['completion_tokens']}",flush=True)
        return row

def canonical_prose(text):
    # Typography is not a factual error: normalize compatibility forms, spaces
    # and Unicode dash punctuation on BOTH sides of prose containment checks.
    # Exact JSON and integer scorers intentionally do not use this function.
    return ''.join('-' if unicodedata.category(c)=='Pd' else c
                   for c in unicodedata.normalize('NFKC',str(text))).casefold()

def score_answer(task,text):
    if task['scorer']=='review':return None
    if task['scorer']=='integer':
        # Arithmetic correctness is separate from the requested terse output format.
        last=text.strip().splitlines()[-1] if text.strip() else ''
        return bool(re.fullmatch(r'\s*'+re.escape(task['checks'][0])+r'[.!]?\s*',last))
    if task['scorer']=='json':
        try:return json.loads(re.sub(r'^```(?:json)?\s*|\s*```$','',text.strip()))==task['checks']
        except ValueError:return False
    folded=canonical_prose(text)
    def matches(c):
        if c=='reachable':
            return bool(re.search(r'\breachable\b|reachability[^\n]*\btrue\b|connection[^\n]*\bsuccess',folded)) and not re.search(r'\bnot reachable\b|\bunreachable\b',folded)
        return canonical_prose(c) in folded
    return all(matches(c) for c in task['checks'])

def distribution(values):
    if not values:return {'n':0}
    v=sorted(values)
    def q(p):
        x=(len(v)-1)*p;i=int(x);return v[i]+(v[min(i+1,len(v)-1)]-v[i])*(x-i)
    return {'n':len(v),'mean':statistics.mean(v),'median':statistics.median(v),'sd':statistics.stdev(v) if len(v)>1 else None,
            'min':v[0],'max':v[-1],'p90':q(.9),'p95':q(.95),'p99':q(.99)}
def bootstrap(values,rng,count=2000):
    if len(values)<2:return None
    means=sorted(statistics.mean(rng.choices(values,k=len(values))) for _ in range(count))
    return [means[int(count*.025)],means[min(count-1,int(count*.975))]]
def cluster_bootstrap(pairs,fn,rng,count):
    clusters={}
    for a,b in pairs:clusters.setdefault(a.get('independent_unit',a['task_id']),[]).append(fn(a,b))
    units=list(clusters.values())
    if len(units)<2:return None
    means=sorted(statistics.mean(x for c in rng.choices(units,k=len(units)) for x in c) for _ in range(count))
    return [means[int(count*.025)],means[min(count-1,int(count*.975))]]

def wilson(k,n):
    if not n:return None
    z=1.95996398454; den=1+z*z/n; center=(k/n+z*z/(2*n))/den
    margin=z*math.sqrt((k/n)*(1-k/n)/n+z*z/(4*n*n))/den
    return [center-margin,center+margin]

