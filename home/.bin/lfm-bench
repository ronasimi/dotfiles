                    msgs=[{'role':'system','content':'Respond in text only.'},{'role':'user','content':[{'type':'text','text':'Describe or transcribe this media briefly.'},part]}]
                    r=self.chat('omni',msgs,False,False,{'task_id':'probe-'+row['format'],'mode':'preflight'},attempt+'-format-probe',128)
                    _,text,_=visible_message(r)
                    # Decode/API acceptance is independent of recognition completeness or accuracy.
                    row[attempt+'_accepted']=True
                    row[attempt+'_recognition_complete']=bool(text) and r['choices'][0].get('finish_reason')!='length'
                    row[attempt+'_finish_reason']=r['choices'][0].get('finish_reason')
                    row['usable']=bool(text)
