                batch={"text": tb, "omni": ob, "decision": 1024},
                ubatch={"text": tu, "omni": ou, "decision": 1024},
                threads={"text": gt if placement[0] == "v" else 6,
                         "omni": gt if placement[1] == "v" else 6,
