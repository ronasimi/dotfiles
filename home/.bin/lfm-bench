            row.update(finish_reason=r['choices'][0].get('finish_reason'),visible_characters=len(text),
                       reasoning_characters=len(msg.get('reasoning_content') or ''),thinking_leakage=leaked,
                       reasoning_tokens=details.get('reasoning_tokens'),visible_tokens=details.get('visible_tokens'),
                       cache_tokens=(u.get('prompt_tokens_details') or {}).get('cached_tokens'),
