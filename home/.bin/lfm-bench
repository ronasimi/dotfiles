def parser():
    p=argparse.ArgumentParser(description=__doc__)
    for name,helptext in [('all','Full suite including mixed contention'),('smoke','Short real-model validation (use --samples 1)'),('tools','Tool and gating suite'),('media','Media suite only'),('mixed','Mixed/concurrent suite only'),('health','Check all six endpoints'),('self-test','Offline deterministic fixture tests'),('live','Print classifier decisions, tools and streamed model answers'),('show-reasoning','Also print reasoning deltas (implies --live)')]:
        p.add_argument('--'+name,action='store_true',help=helptext)
    p.add_argument('--quick',action='store_true',help='Focused paired suite: summary, extraction, coding, reasoning, single_network; no media discovery or long-context stress')
    p.add_argument('--reasoning',choices=['compare','on','off','adaptive'],default='compare')
    p.add_argument('--hours',type=float,default=8,help='Active wall-clock budget; completes current paired block; resume uses remaining budget')
    p.add_argument('--samples','--runs',type=int,default=30,help='Distinct generated instances per category, not repetitions of one prompt')
    p.add_argument('--seed',type=int,default=20261105)
    p.add_argument('--transport',choices=['http','unix'],default='http');p.add_argument('--timeout',type=float,default=240)
    p.add_argument('--max-tokens',type=int,default=1024);p.add_argument('--max-hops',type=int,default=5)
    p.add_argument('--thinking-threshold',type=float,default=.5);p.add_argument('--tool-threshold',type=float,default=.5)
    p.add_argument('--ambiguity-margin',type=float,default=.1);p.add_argument('--fallback',choices=['on','off'],default='on')
    p.add_argument('--failure-threshold',type=float,default=.5);p.add_argument('--failure-window',type=int,default=12)
    p.add_argument('--bootstrap',type=int,default=2000);p.add_argument('--sample-interval',type=float,default=2)
    p.add_argument('--context-lines',type=int,default=400)
    p.add_argument('--decision-max-chars',type=int,default=1600,help='Head/tail character budget for the 1K classifier; full chat input unchanged')
    p.add_argument('--media-root',default=str(Path.home()));p.add_argument('--image-file')
    p.add_argument('--max-media-mb',type=float,default=8);p.add_argument('--max-media-seconds',type=float,default=15)
    p.add_argument('--resume',nargs='?',const='latest',help='Resume run directory, or latest run if no path')
    p.add_argument('--report',metavar='RUN',help='Regenerate reports without inference')
    p.add_argument('--watch',nargs='?',const='latest',help='Follow saved decisions and outputs; no model requests')
    p.add_argument('--prompt',help='Custom prompt; factual correctness marked human-review only')
    p.add_argument('--legacy',action='store_true',help='Launch original benchmark backup')
    return p

def resolve_run(value):
    if value=='latest':return Path((ROOT/'latest').read_text().strip())
    p=Path(value).expanduser().resolve()
    if not p.is_relative_to(ROOT.resolve()) or not p.is_dir():raise ValueError('Run must be beneath '+str(ROOT))
    return p

def watch(run,reasoning=False):
    print(f'Watching {run}/events.jsonl (Ctrl-C to stop)',flush=True)
    with (run/'events.jsonl').open() as f:
        while not STOP.is_set():
            line=f.readline()
            if not line:time.sleep(.2);continue
            try:r=json.loads(line)
            except ValueError:continue
            if r['event']=='delta':
                v=r.get('content') or (r.get('reasoning') if reasoning else '')
                if v:print(v,end='',flush=True)
            else:print('\n'+json.dumps(r,ensure_ascii=False),flush=True)

def main():
    p=parser();o=p.parse_args()
    if o.legacy:
        os.execv(sys.executable,[sys.executable,str(ROOT/'development/lfm-bench.original.py')])
    if o.show_reasoning:o.live=True
    if o.samples<1 or o.hours<=0 or o.max_tokens<32 or o.timeout<1 or o.max_hops<1 or o.bootstrap<100 or o.sample_interval<.5 or o.failure_window<3 or o.context_lines<1 or o.decision_max_chars<100:
        p.error('Invalid positive limits (tokens >=32, bootstrap >=100, interval >=0.5, failure window >=3)')
    if not all(0<=x<=1 for x in [o.thinking_threshold,o.tool_threshold,o.ambiguity_margin,o.failure_threshold]):p.error('Thresholds must be in [0,1]')
    if o.self_test:return self_test(o)
    if o.health:return 0 if health(API(o)) else 1
    if o.watch:watch(resolve_run(o.watch),o.show_reasoning);return 0
    if o.report:
        run=resolve_run(o.report);saved=json.loads((run/'config.json').read_text());report(run,argparse.Namespace(**saved));print(run/'report.md');return 0
    if len([v for v in (o.tools,o.media,o.mixed,o.prompt,o.quick) if v])>1:p.error('Choose one subset, or --all for the full suite')
    if not any((o.all,o.smoke,o.tools,o.media,o.mixed,o.prompt,o.resume,o.quick)) and sys.stdin.isatty():
        print('1 Full paired benchmark  2 Adaptive only  3 Tools  4 Media  5 Mixed  6 Health  7 Custom prompt  q Quit')
        answer=input('Benchmark> ').strip()
        if answer=='q':return 0
        if answer=='6':return 0 if health(API(o)) else 1
        if answer=='2':o.reasoning='adaptive'
        elif answer=='3':o.tools=True
        elif answer=='4':o.media=True
        elif answer=='5':o.mixed=True
        elif answer=='7':o.prompt=input('Prompt> ')
        elif answer!='1':p.error('Invalid menu selection')
        o.live=input('Observe decisions and answers? [Y/n] ').strip().lower()!='n'
    ROOT.mkdir(parents=True,exist_ok=True)
    if o.resume:
        run=resolve_run(o.resume); saved=json.loads((run/'config.json').read_text())
        live=o.live;show=o.show_reasoning
        o=argparse.Namespace(**saved);o.live=live;o.show_reasoning=show
        if saved.get('schema')!=SCHEMA:raise ValueError('Incompatible checkpoint schema')
        if saved.get('executable_sha256')!=digest(__file__):raise ValueError('Benchmark code changed; do not mix experimental versions. Start a new run.')
    else:
        run=ROOT/('run-'+datetime.now().strftime('%Y%m%d-%H%M%S')+'-'+str(os.getpid()));run.mkdir(mode=0o700)
        os.chmod(run,0o700);o.schema=SCHEMA;o.executable_sha256=digest(__file__);dump(run/'config.json',vars(o));(ROOT/'latest').write_text(str(run)+'\n')
    # Advisory locks prevent two benchmark instances contending unintentionally, and duplicate resume.
    with (ROOT/'runner.lock').open('a') as lock:
        try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:raise ValueError('Another benchmark runner holds the lock')
        e=Engine(o,run);sampler=Sampler(e); checkpoint={'elapsed_s':0,'completed':[],'status':'preflight'}
        if (run/'checkpoint.json').exists():checkpoint=json.loads((run/'checkpoint.json').read_text())
        base_elapsed=checkpoint.get('elapsed_s',0);session=time.monotonic();records=read_rows(run/'results.jsonl')
        done={(r['task_id'],r['mode']) for r in records}
        print(f'Run: {run}\nPID: {os.getpid()}\nWatch: lfm-bench --watch {run}\nLive log: tail -f {run}/events.jsonl',flush=True)
        try:
            if not health(e.api):raise APIError('Health preflight failed')
            meta=metadata(e.api);dump(run/('metadata-resume-'+str(os.getpid())+'.json' if o.resume else 'metadata.json'),meta)
            e.pids=list(meta['processes']);sampler.start()
            if o.resume:
                original=json.loads((run/'metadata.json').read_text())
                for role in PORTS:
                    for key in ('model_path','model_ftype','build_info','chat_template'):
                        if original['servers'][role].get(key)!=meta['servers'][role].get(key):raise ValueError(f'Runtime changed: {role} {key}; start a new run')
                old=sorted((v['argv'],v['models']) for v in original['processes'].values())
                new=sorted((v['argv'],v['models']) for v in meta['processes'].values())
                if old!=new:raise ValueError('Runtime flags or model identifiers changed; start a new run')
            if (run/'workload-manifest.json').exists():tasks=json.loads((run/'workload-manifest.json').read_text())
            else:
                media,errors=media_discover(o) if not o.tools and not o.prompt and not getattr(o,'quick',False) else ([],[])
                dump(run/'media-manifest.json',media);dump(run/'media-discovery-errors.json',errors)
                # Warmups are deliberately excluded from experiment results.
                for role in ('text','omni'):
                    r,m,payload=e.api.chat(role,[{'role':'user','content':'Reply ready.'}],False,None,{'mode':'warmup'},128)
                    e.request_record({'task_id':'warmup','mode':'warmup'},role,'warmup',payload,r,m)
                r,m,payload=e.api.decision('What is a Linux symlink?');e.request_record({'task_id':'warmup','mode':'warmup'},'decision','warmup',payload,r,m)
                e.probe_media(media);tasks=generate(o,media);dump(run/'workload-manifest.json',tasks)
            if not tasks:raise ValueError('No eligible workloads; inspect media manifest')
            checkpoint['status']='running';dump(run/'checkpoint.json',checkpoint)
            dump(run/'preflight.json',{'utc':now(),'tasks':len(tasks),'arms':sum(len(t['mode_order']) for t in tasks),
                'categories':{c:sum(t['category']==c for t in tasks) for c in sorted({t['category'] for t in tasks})},
                'independent_units':len({t.get('independent_unit',t['id']) for t in tasks}),
                'budget_hours':o.hours,'generation_limit':o.max_tokens})
            for task in tasks:
                if STOP.is_set() or base_elapsed+time.monotonic()-session>=o.hours*3600:break
                for mode in task['mode_order']:
                    if (task['id'],mode) in done:continue
                    if STOP.is_set():break
                    row=e.one(task,mode);records.append(row);done.add((task['id'],mode))
                    checkpoint.update(completed=[list(x) for x in sorted(done)],elapsed_s=base_elapsed+time.monotonic()-session,status='running',last_task=task['id'])
                    dump(run/'checkpoint.json',checkpoint)
                    window=records[-o.failure_window:]
                    if len(window)>=o.failure_window and sum(r['infrastructure_error'] for r in window)/len(window)>=o.failure_threshold:
                        raise APIError('Infrastructure failure-rate abort threshold reached')
                if len(done)%30==0: report(run,o)
            checkpoint['status']='interrupted' if STOP.is_set() else ('complete' if len(done)==sum(len(t['mode_order']) for t in tasks) else 'budget_exhausted')
        except (APIError,ValueError,OSError,InterruptedError) as err:
            checkpoint.update(status='interrupted' if isinstance(err,InterruptedError) else 'aborted',error=str(err))
            print(str(err),file=sys.stderr,flush=True);e.append('errors.jsonl',{'utc':now(),'preflight_or_runner_error':str(err)})
        finally:
            if sampler.thread.is_alive():sampler.close()
            checkpoint['elapsed_s']=base_elapsed+time.monotonic()-session;dump(run/'checkpoint.json',checkpoint)
            report(run,o);print(f"Status: {checkpoint['status']}\nReport: {run}/report.md",flush=True)
        return 1 if checkpoint['status']=='aborted' else 0

