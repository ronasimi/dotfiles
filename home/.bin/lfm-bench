def measure_request(model, payload, case, trial, stage_name, timeout=100):
    path='/v1/systemone' if model == 'decision' else '/v1/chat/completions'
    t0=time.monotonic()
    reply=http(PORTS[model],path,payload,timeout=timeout)
    elapsed=(time.monotonic()-t0)*1000
    timings=reply.get('timings') or {}
    usage=reply.get('usage') or {}
    prompt_ms = timings.get('prompt_ms')
    gen_ms = timings.get('predicted_ms') if model!='decision' else None
    result = {'config':case,'trial':trial, 'stage':stage_name, 'model':model,
              'wall_ms':elapsed, 'prefill_ms':prompt_ms,'generation_ms':gen_ms,
              'prefill_tps':timings.get('prompt_per_second'),
              'generation_tps':timings.get('predicted_per_second'),
              'prefill_tokens':timings.get('prompt_n',usage.get('input_tokens')),
              'cached_tokens':timings.get('cache_n'),
              'generation_tokens':timings.get('predicted_n',usage.get('output_tokens')),
              'route_choice':'', 'route_correct':'',
              'error':''}
    if model == 'decision':
        result['route_choice'] = (((reply.get('answers') or {}).get('route') or {}).get('choice')) or ''
        result['route_correct'] = result['route_choice'] == trial.split('_')[1] if trial.startswith('direct_') else None
    output = ((reply.get('choices') or [{}])[0].get('message') or {}).get('content') or ''
    if isinstance(output, list): output = json.dumps(output)
    return result, output


def wait_health(proc, port, deadline):
    while time.monotonic()<deadline and not SHUTDOWN:
        if proc.poll() is not None:
            raise RuntimeError(f'llama-server exited code {proc.returncode} before health check')
        try:
            resp=http(port,'/health',timeout=2)
            if resp.get('status') not in ('loading model','loading', 'not ready'):
                return
        except Exception:
            pass
        time.sleep(.75)
    raise TimeoutError(f'health timeout port {port}')


def launch_one(model, config, binary, pathmap, logs, monitor, deadline):
    backend=config['backend'][model]
    ngl=config['ngl'][model]
    args=[str(binary), '-m', str(pathmap[model]),
          '--host','127.0.0.1', '--port',str(PORTS[model]),
          '--alias',ALIASES[model], '-ngl',str(ngl),'--fit','off',
          '-b',str(config['batch'][model]), '-ub',str(config['ubatch'][model]),
          '-c',str(CONTEXTS[model]),'-t',str(config['threads'][model]),
          '-tb',str(config['threads_batch'][model]),
          '-np','1','-fa','on','--poll',str(config['poll']),
          '--poll-batch',str(config['poll']), '--metrics']
    if model != 'decision':
        args.extend(['-ctk','q4_0','-ctv','q4_0','--jinja'])
    if backend == 'c':
        args.extend(['--device','none','--no-kv-offload','--no-op-offload'])
    if model in ('omni','decision'):
        args.extend(['-mm',str(pathmap[model+'_mm'])])
        if backend == 'c': args.append('--no-mmproj-offload')
    if model == 'text': args.extend(['--temp','0.1'])
    if model == 'omni': args.extend(['--temp','0','--reasoning','off'])
    logname = logs / f'{model}.log'
    f = logname.open('w')
    f.write('CMD: '+subprocess.list2cmdline(args)+'\n\n')
    f.flush()
    def deprioritize():
        try: os.nice(8)
        except OSError: pass
    try:
        proc=subprocess.Popen(args, stdout=f, stderr=subprocess.STDOUT,
                              stdin=subprocess.DEVNULL, start_new_session=True,
                              preexec_fn=deprioritize)
    except Exception:
        f.close(); raise
    CURRENT_PROCESSES.append(proc)
    try:
        wait_health(proc,PORTS[model],min(deadline,time.monotonic()+115))
        props=http(PORTS[model],'/props',timeout=5)
        advertised = props.get('default_generation_settings',{}).get('n_ctx',props.get('n_ctx'))
        if advertised is not None and int(advertised)!=CONTEXTS[model]:
            raise RuntimeError(f'{model} context mismatch: expected {CONTEXTS[model]}, got {advertised}')
    finally:
        f.close()
    return proc, args


def kill_models(processes):
    for p in processes:
        if p.poll() is None:
            try: os.killpg(p.pid,signal.SIGTERM)
            except ProcessLookupError: pass
    for p in processes:
        if p.poll() is None:
            try: p.wait(timeout=5)
            except subprocess.TimeoutExpired:
                try: os.killpg(p.pid,signal.SIGKILL)
                except ProcessLookupError: pass
    for p in processes:
        try: CURRENT_PROCESSES.remove(p)
        except ValueError: pass


def services_active():
    if not shutil.which('systemctl'): return []
    active=[]
    for name in ('text','omni','decision'):
        p=subprocess.run(['systemctl','--user','is-active','--quiet',f'lfm@{name}.service'],
                         capture_output=True)
        if p.returncode==0: active.append(name)
    return active


def service_cmd(action, model):
    p=subprocess.run(['systemctl','--user',action,f'lfm@{model}.service'],
                     capture_output=True,text=True,timeout=30)
    if p.returncode: raise RuntimeError(f'{action} lfm@{model} failed: {p.stderr[:400]}')


def append_csv(filename, rows):
    if not rows: return
    fields = list(dict.fromkeys(k for row in rows for k in row))
    with Path(filename).open('w',newline='') as f:
        w=csv.DictWriter(f,fieldnames=fields,extrasaction='ignore')
        w.writeheader();w.writerows(rows)


def result_report(results, phases, stages, monitor, output, args):
    report=[]
    report.append('# LFM3 three-model pipeline benchmark')
    report.append(f'\nGenerated: {dt.datetime.now().isoformat(timespec="seconds")} · Max budget: {args.max_minutes} min · Completed configs: {len(results)}')
    report.append('\n**Scope:** 128K Text, 32K Omni, 1K D1, Q4_0 K/V for causal models; all three servers resident concurrently per configuration. Separate local ports; synthetic text and image payloads.')
    report.append('\n### Ranking (smaller wall time and jitter, larger available RAM are better)\n')
    report.append('| Configuration | Status | Pipeline mean (s) | Mean pref./gen. (s) | Cold prefill t/s | Decode t/s | Peak CPU/GPU % | Peak RAM / VRAM (GiB) | Min available RAM (GiB) | Lag p95 (ms) |')
    report.append('|---|---|---:|---:|---:|---:|---|---|---:|---:|')
    passed=[r for r in results if r['status']=='ok']
    for r in sorted(results, key=lambda r:(r['status']!='ok',r.get('score',1e8))):
        pf=r.get('prefill_ms'); gen=r.get('generation_ms'); ram=r.get('peak_ram_used_mib'); vr=r.get('peak_vram_mib')
        report.append('| {name} | {status} | {total} | {times} | {pps} | {dps} | {cpu}/{gpu} | {ram}/{vram} | {avail} | {lag} |'.format(
            name=r['name'], status=r['status'].replace('|','/'),
            total=nicefmt((r.get('mean_pipeline_wall_ms') or 0)/1000,2) if r.get('mean_pipeline_wall_ms') is not None else '-',
            times=f'{nicefmt((pf or 0)/1000,2)}/{nicefmt((gen or 0)/1000,2)}' if pf is not None or gen is not None else '-',
            pps=nicefmt(r.get('prefill_tps')), dps=nicefmt(r.get('generation_tps')),
            cpu=nicefmt(r.get('peak_cpu_percent'),0),gpu=nicefmt(r.get('peak_gpu_busy_pct'),0),
            ram=nicefmt(ram/1024,2) if ram is not None else '-',
            vram=nicefmt(vr/1024,2) if vr is not None else '-',
            avail=nicefmt(r.get('min_ram_available_mib',0)/1024,2) if r.get('min_ram_available_mib') is not None else '-',
            lag=nicefmt(r.get('scheduler_lag_p95_ms'),1)))
    report.append('\n*Mean prefill and generation times are the summed stage times per complete pipeline; d1 is a classifier, so its wall time is separately reported and it has no generation stage.*')
    report.append('\n### Per-model throughput and route latency (successful configurations)\n')
    report.append('| Configuration | Text prefill t/s | Text gen t/s | Omni prefill t/s | Omni gen t/s | D1 decision ms | Direct Text s | Direct Omni s | Three-model s | Route accuracy |')
    report.append('|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|')
    for r in sorted(passed,key=lambda v:v.get('score',1e8)):
        name=r['name']
        getavg=lambda model,key: stats([s.get(key) for s in stages if s['config']==name and s['model']==model and not s['stage'].startswith('cache_') and not s['stage'].startswith('text_stress')])['mean']
        chainavg=lambda typ: stats([p['wall_ms']/1000 for p in phases if p['config']==name and p['pipeline']==typ])['mean']
        report.append('| '+name+' | '+ ' | '.join([
            nicefmt(getavg('text','prefill_tps')),nicefmt(getavg('text','generation_tps')),
            nicefmt(getavg('omni','prefill_tps')),nicefmt(getavg('omni','generation_tps')),
            nicefmt(getavg('decision','wall_ms'),0),nicefmt(chainavg('direct_text'),2),
            nicefmt(chainavg('direct_omni'),2),nicefmt(chainavg('triple'),2),
            nicefmt(100*r['route_accuracy'],0)+'%' if r.get('route_accuracy') is not None else '-'])+' |')
    report.append('\n### Configuration guidance\n')
    if passed:
        acceptable=[r for r in passed if (r.get('min_ram_available_mib') or 0)>=2300 and
                    (r.get('scheduler_lag_p95_ms') or 0)<=80 and
                    (r.get('peak_mem_psi_avg10') or 0)<=8 and
                    (r.get('peak_vram_mib') is None or r['peak_vram_mib']<=5120)]
        fastest=min(passed,key=lambda r:r.get('mean_pipeline_wall_ms',1e8))
        report.append(f'- Fastest completed case: **{fastest["name"]}** (mean pipeline {nicefmt(fastest.get("mean_pipeline_wall_ms",0)/1000,2)} s).')
        if acceptable:
            good=min(acceptable,key=lambda r:r.get('mean_pipeline_wall_ms',1e8))
            report.append(f'- Best performance passing conservative desktop-headroom filters: **{good["name"]}** (≥2.3 GiB available RAM, lag p95 ≤80 ms, memory PSI avg10 ≤8%, and sampled VRAM use ≤5 GiB where observable).')
            report.append('- Consider this a **candidate**, not proven interactive responsiveness; foreground keystroke/compositor latency was not measured directly.')
        else:
            report.append('- No successful configuration met the desktop-headroom thresholds. Prefer lighter CPU thread counts, smaller microbatch, or sequential loading.')
    else: report.append('- No complete configuration; check per-server logs and memory budget.')
    report.append('\n### What was measured\n')
    report.append('- Each case includes `direct_text` (D1 → Text), `direct_omni` (D1 → Omni with a synthetic PNG), and `triple` (D1 → Text → Omni → Text, with genuine model output handoffs).')
    report.append('- D1 route accuracy is logged, but the fixed target for each direct test is used for **comparable throughput** when D1 misroutes. This is a controlled benchmark, not a live user-facing autonomous agent.')
    report.append('- `stages.csv` includes per-request `prefill_ms`, `generation_ms`, `prefill_tps`, `generation_tps`, wall time, and prompt-cache tokens; `trials.csv` includes whole-chain latency.')
    report.append('- The `cache_text` stage compares first-pass and repeated-prefix prefill (cold vs cached), excluded from pipeline ranking.')
    report.append('- `samples.jsonl` measures system CPU, GPU busy, RAM available/used, amdgpu VRAM and GTT usage, memory/CPU PSI and scheduler wakeup lag every 200 ms. These are whole-system metrics including compositor, not model-only memory allocations.')
    report.append('- Startup/model loading is excluded from steady-state pipeline latency but included in resource peaks. `server_logs/` retains complete startup/failure diagnostics.')
    report.append('- AMD APUs use shared memory: VRAM/GTT accounting and RAM usage are not independent additive totals. VRAM readings may be unavailable on a given kernel.')
    report.append('- Requests use identical synthetic data and 64–80 output-token caps (32 for stress). The test does not measure full 128K-context prefill, audio/video throughput, or real application input latency under Hyprneuro automation.')
    report.append('- Dangerous low-memory configurations are stopped, failures are recorded, and active `lfm@` services are restored on exit when possible.')
    report.append('\n### Logs\n')
    report.append('`summary.md`, `results.json`, `stages.csv`, `trials.csv`, `samples.jsonl`, `configurations.json`, `server_logs/<case>/*.log`.')
    (output/'summary.md').write_text('\n'.join(report)+'\n')
    (output/'results.json').write_text(json.dumps(results,indent=2)+'\n')
    append_csv(output/'stages.csv',stages)
    append_csv(output/'trials.csv',phases)
    return fastest['name'] if passed else None


def on_signal(signum, frame):
    global SHUTDOWN
    SHUTDOWN=True
    print(f'\nSignal {signum}: ending after current request and restoring services.',flush=True)
    # Throw immediately so a hanging urllib request cannot delay cleanup.
    raise KeyboardInterrupt


def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--server', default=os.environ.get('LFM_SERVER','/usr/local/bin/llama-server'))
    p.add_argument('--model-dir', default=os.environ.get('LFM_MODEL_DIR',str(Path.home()/'.models')))
    p.add_argument('--output',default=str(Path.home()/f'lfm-bench-{dt.datetime.now():%Y%m%d-%H%M%S}'))
    p.add_argument('--max-minutes',type=int,default=105)
    p.add_argument('--repeats',type=int,default=2)
    p.add_argument('--no-stress-prefill',action='store_true',help='Skip large text prefill per case')
    p.add_argument('--start-config',type=int,default=1,help='1-based starting matrix index')
    p.add_argument('--limit-configs',type=int,default=None)
    p.add_argument('--no-service-management',action='store_true',help='Require lfm@ services already stopped; never alter them')
    p.add_argument('--list-configs',action='store_true')
    p.add_argument('--dry-run',action='store_true',help='Print matrix and preflight paths without changing services')
    args=p.parse_args()
    if not 5<=args.max_minutes<=110: p.error('--max-minutes must be 5..110')
    if not 1<=args.repeats<=10: p.error('--repeats must be 1..10')
    matrix=build_matrix()
    matrix=matrix[args.start_config-1:]
    if args.limit_configs is not None: matrix=matrix[:args.limit_configs]
    if args.list_configs or args.dry_run:
        for i,cfg in enumerate(matrix,args.start_config):
            print(f'{i:02d} {cfg["name"]:<36} backend={cfg["backend"]} '
                  f'batch={cfg["batch"]["text"]}/{cfg["ubatch"]["text"]} '
                  f'omni={cfg["batch"]["omni"]}/{cfg["ubatch"]["omni"]} poll={cfg["poll"]}')
        if args.list_configs: return 0
    if args.dry_run:
        print('binary',args.server, 'model-dir',args.model_dir)
        return 0
    binary=Path(args.server).expanduser()
    root=Path(args.model_dir).expanduser()
    pathmap={
       'text':root/'text/LFM3-1.7B-QAD-Q4_0.gguf',
       'omni':root/'omni/LFM3-Omni-2B-Q4_K_M.gguf',
       'omni_mm':root/'omni/mmproj-LFM3-Omni-2B-Q4_K_M.gguf',
       'decision':root/'decision/d1-omni-600M-Q8_0.gguf',
       'decision_mm':root/'decision/mmproj-d1-omni-600M-Q8_0.gguf'
    }
    missing=[str(path) for path in [binary,*pathmap.values()] if not path.is_file()]
    if missing: p.error('Missing llama.cpp binary or model files: '+', '.join(missing))
    active=services_active()
    if active and args.no_service_management:
        p.error('Active lfm@ services exist: '+', '.join(active)+'; stop them first or omit --no-service-management')
    for port in PORTS.values():
        with socket.socket(socket.AF_INET,socket.SOCK_STREAM) as sock:
            if sock.connect_ex(('127.0.0.1',port)) == 0:
                p.error(f'Benchmark port {port} already in use; refusing to interfere with existing server')
    available=meminfo().get('MemAvailable',0)/MIB
    if available<2500:
        p.error(f'Not enough available RAM ({available:.0f} MiB). Need at least 2.5 GiB before starting.')
    output=Path(args.output).expanduser().absolute()
    output.mkdir(parents=True,exist_ok=True)
    logs_root=output/'server_logs';logs_root.mkdir(exist_ok=True)
    (output/'configurations.json').write_text(json.dumps(matrix,indent=2)+'\n')
    start=time.monotonic()
    deadline=start+args.max_minutes*60
    monitor=Monitor(output/'samples.jsonl')
    results=[];phases=[];stages=[]
    services_stopped=[]
    for sig in (signal.SIGTERM,signal.SIGINT): signal.signal(sig,on_signal)
    # Hard watchdog: allow 5 minutes above the scheduling budget for final requests.
    if hasattr(signal,'SIGALRM'):
        signal.signal(signal.SIGALRM,on_signal)
        signal.setitimer(signal.ITIMER_REAL, (args.max_minutes+5)*60)
    print(f'Benchmark directory: {output}\nTime cap: {args.max_minutes} minutes; '
          f'{len(matrix)} configurations; {args.repeats} repetitions each.',flush=True)
    print(f'Initial MemAvailable: {available:.0f} MiB. Lower process priority; monitor at 200 ms.',flush=True)
    image_url=png_test_image()
    try:
        for m in active:
            print('Temporarily stopping lfm@'+m+'; will restore at end.',flush=True)
            service_cmd('stop',m); services_stopped.append(m)
        monitor.start()
        # Reference measurements before launching any local models.
        time.sleep(1)
        for i,cfg in enumerate(matrix,args.start_config):
            if SHUTDOWN or time.monotonic() > deadline-180:
                print('Time budget exhausted; stopping matrix.',flush=True);break
            name=cfg['name']
            monitor.mark(config=name,trial='load')
            case_start=time.monotonic()
            proc=[];cfg_stages=[];cfg_trials=[]
            reason=''; status='ok'
            case_dir=logs_root/name;case_dir.mkdir(exist_ok=True)
            print(f'[{i}/{args.start_config+len(matrix)-1}] {name}',flush=True)
            try:
                for model in ('decision','text','omni'):
                    good,why=monitor.health()
                    if not good: raise MemoryError(why)
                    if time.monotonic() > deadline-100:
                        raise TimeoutError('global time budget nearly reached')
                    p_obj, cmd=launch_one(model,cfg,binary,pathmap,case_dir,monitor,deadline)
                    proc.append(p_obj)
                    print(f'  Loaded {model} ({"GPU" if cfg["ngl"][model] else "CPU"}), pid {p_obj.pid}',flush=True)
                # Warmup one tiny request for each server; not timed/recorded as trial.
                monitor.mark(trial='warmup')
                for model in ('decision','text','omni'):
                    pl=decision_payload('text') if model=='decision' else prompt_payload('omni' if model=='omni' else 'text',image_url=image_url)
                    if model!='decision': pl['max_tokens']=1;pl['cache_prompt']=False
                    http(PORTS[model],'/v1/systemone' if model=='decision' else '/v1/chat/completions',pl,timeout=90)
                # Benchmark each pipeline with actual network API handoffs and identical inputs.
                for repeat in range(args.repeats):
                    for typ in ('direct_text','direct_omni','triple'):
                        if time.monotonic()>deadline-100:
                            raise TimeoutError('global time budget nearly reached')
                        good,why=monitor.health()
                        if not good: raise MemoryError(why)
                        trial=f'{typ}_{repeat+1}'
                        monitor.mark(trial=trial)
                        trial_start=time.monotonic()
                        trial_stages=[]
                        expected='omni' if typ=='direct_omni' else 'text'
                        decision_result,_=measure_request('decision',decision_payload(expected),name,typ,
                                                          'd1_route',timeout=80)
                        decision_result['route_correct']=decision_result['route_choice']==expected
                        trial_stages.append(decision_result)
                        previous=''
                        if typ=='direct_text':
                            row,previous=measure_request('text',prompt_payload('text',long=True),name,trial,'text',timeout=110)
                            trial_stages.append(row)
                        elif typ=='direct_omni':
                            row,previous=measure_request('omni',prompt_payload('omni',image_url=image_url),name,trial,'omni_image',timeout=110)
                            trial_stages.append(row)
                        else:
                            row,previous=measure_request('text',prompt_payload('text',long=True),name,trial,'text_plan',timeout=110)
                            trial_stages.append(row)
                            row,previous=measure_request('omni',prompt_payload('omni',previous=previous,image_url=image_url),name,trial,'omni_review',timeout=110)
                            trial_stages.append(row)
                            row,previous=measure_request('text',prompt_payload('final',previous=previous,long=False),name,trial,'text_finish',timeout=110)
                            trial_stages.append(row)
                        elapsed=(time.monotonic()-trial_start)*1000
                        prefill=sum(s.get('prefill_ms') or 0 for s in trial_stages)
                        generation=sum(s.get('generation_ms') or 0 for s in trial_stages)
                        trial_rec={'config':name,'trial':trial,'pipeline':typ, 'repetition':repeat+1,
                                   'wall_ms':round(elapsed,2),'prefill_ms':round(prefill,2),
                                   'generation_ms':round(generation,2),
                                   'd1_wall_ms':round(decision_result['wall_ms'],2),
                                   'route_choice':decision_result['route_choice'],
                                   'route_correct':decision_result['route_correct']}
                        cfg_trials.append(trial_rec); cfg_stages.extend(trial_stages)
                        print('  ',typ,f'run {repeat+1}: {elapsed/1000:.2f}s, '
                              f'prefill {prefill/1000:.2f}s, gen {generation/1000:.2f}s, '
                              f'd1 {decision_result["wall_ms"]:.0f}ms, route {decision_result["route_choice"]}',flush=True)
                if not args.no_stress_prefill:
                    # Large uncached text prompt probes prefill and memory pressure.
                    monitor.mark(trial='stress_prefill')
                    good,why=monitor.health()
                    if not good: raise MemoryError(why)
                    stress_payload=prompt_payload('text',repeats=180)
                    stress_payload['max_tokens']=32
                    stage,_=measure_request('text',stress_payload,name,'stress_prefill','text_stress_approx8k',timeout=150)
                    cfg_stages.append(stage)
                    print(f'  stress: prefill={nicefmt(stage["prefill_ms"])}ms '
                          f'prefill_tokens={stage["prefill_tokens"]} '
                          f'prefill_tps={nicefmt(stage["prefill_tps"])}',flush=True)
                # Cache reuse test on consistent text prefix; not part of pipeline timing.
                monitor.mark(trial='cache_text')
                base=prompt_payload('text',long=True)
                base['cache_prompt']=True
                for c in ('first','cached'):
                    data=dict(base)
                    # Keep both messages byte-identical to demonstrate prefix reuse.
                    row,_=measure_request('text',data,name,'cache_text',f'cache_{c}',timeout=110)
                    cfg_stages.append(row)
                    print(f'  cache {c}: prefill={nicefmt(row["prefill_ms"])}ms '
                          f'cached_tokens={row["cached_tokens"]}',flush=True)
            except Exception as exc:
                status='failed';reason=f'{type(exc).__name__}: {exc}'
                print('  FAILED:',reason,flush=True)
            finally:
                monitor.mark(trial='unload')
                kill_models(list(CURRENT_PROCESSES))
                time.sleep(.6)
                resources=monitor.aggregate(case_start,time.monotonic())
                measured=[s for s in cfg_stages if not s['stage'].startswith('cache_') and not s['stage'].startswith('text_stress')]
                prefill_items=[s for s in measured if s.get('prefill_tps') and s.get('prefill_tokens') and s.get('prefill_tokens')>10]
                generation_items=[s for s in measured if s.get('generation_tps') and s.get('generation_tokens') and s.get('generation_tokens')>1]
                rec={'name':name,'status':status,'error':reason,'configuration':cfg,
                     'start_offset_s':round(case_start-start,2),'duration_s':round(time.monotonic()-case_start,2),
                     'trials_completed':len(cfg_trials),
                     'mean_pipeline_wall_ms': stats([r['wall_ms'] for r in cfg_trials])['mean'],
                     'pipeline_wall_p95_ms':percentile([r['wall_ms'] for r in cfg_trials],95),
                     'prefill_ms':stats([r['prefill_ms'] for r in cfg_trials])['mean'],
                     'generation_ms':stats([r['generation_ms'] for r in cfg_trials])['mean'],
                     'prefill_tps':stats([r['prefill_tps'] for r in prefill_items])['mean'],
                     'generation_tps':stats([r['generation_tps'] for r in generation_items])['mean'],
                     'd1_wall_ms':stats([r['d1_wall_ms'] for r in cfg_trials])['mean'],
                     'route_accuracy':(sum(r['route_correct'] for r in cfg_trials)/len(cfg_trials)) if cfg_trials else None,
                     **resources}
                # Score is heuristic: latency + penalty for RAM pressure, UI scheduling latency, memory PSI.
                rec['score']=((rec.get('mean_pipeline_wall_ms') or 1e8) +
                    max(0,2300-(rec.get('min_ram_available_mib') or 0))*3 +
                    max(0,(rec.get('scheduler_lag_p95_ms') or 0)-40)*80 +
                    max(0,(rec.get('peak_mem_psi_avg10') or 0)-8)*200)
                results.append(rec);phases.extend(cfg_trials);stages.extend(cfg_stages)
                # Save intermediate report even if stopped by SIGINT afterwards.
                result_report(results,phases,stages,monitor,output,args)
                print(f'  Outcome: {status}; min available RAM {nicefmt(rec.get("min_ram_available_mib"),0)} MiB; '
                      f'scheduler lag p95 {nicefmt(rec.get("scheduler_lag_p95_ms"))} ms.\n',flush=True)
                # Vulkan device loss can disrupt the desktop on an APU; do not retry.
                if status == 'failed':
                    server_logs = '\n'.join(read_text(p, '')[-6000:] for p in case_dir.glob('*.log'))
                    if any(x in (reason+'\n'+server_logs).lower() for x in ('errordevicelost', 'vk_error_device_lost', 'device lost')):
                        print('Vulkan device loss detected. Stopping matrix to protect compositor stability.',flush=True)
                        break
    except KeyboardInterrupt:
        print('Interrupted; writing partial results and restoring services.',flush=True)
    finally:
        if hasattr(signal,'SIGALRM'): signal.setitimer(signal.ITIMER_REAL,0)
        kill_models(list(CURRENT_PROCESSES))
        monitor.close()
        result_report(results,phases,stages,monitor,output,args)
        for model in services_stopped:
            try:
                print('Restoring lfm@'+model,flush=True)
                service_cmd('start',model)
            except Exception as e:
                print('WARNING: failed to restore '+model+': '+str(e),file=sys.stderr,flush=True)
        print('\nFinal report: '+str(output/'summary.md')+'\nCSV: '+str(output/'stages.csv')+'\nTelemetry: '+str(output/'samples.jsonl'),flush=True)
    return 0


if __name__=='__main__':
    sys.exit(main())
