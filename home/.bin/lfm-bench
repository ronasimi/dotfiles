                    cmd=['ffmpeg','-nostdin','-v','error','-n','-i',original['path']]
                    if row['kind']=='image':cmd+=['-frames:v','1','-vf','scale=1024:1024:force_original_aspect_ratio=decrease']
                    elif row['kind']=='audio':cmd+=['-t',str(self.o.max_media_seconds),'-ac','1','-ar','16000']
                    else:cmd+=['-t',str(self.o.max_media_seconds),'-an','-vf','scale=640:640:force_original_aspect_ratio=decrease','-r','1']
                    cmd+=[str(target)]
                    try:
                        subprocess.run(cmd,capture_output=True,timeout=90,check=True)
                        row.update(input_path=str(target),input_sha256=digest(target),conversion={'argv':cmd,'source_sha256':original['sha256']})
                    except (OSError,subprocess.SubprocessError) as err:row['conversion_error']=str(err);break
            dump(self.run/'media-manifest.json',media)
    def one(self,task,mode):
        ctx={'task_id':task['id'],'mode':mode};start=time.perf_counter()
        row={'utc':now(),**ctx,'category':task['category'],'input_hash':task['input_hash'],'success':False,
             'infrastructure_error':False,'error':None,'scored':task['scorer']!='review','calls':[],
             'independent_unit':task.get('independent_unit',task['id']),
             'expected_route':task['expected_route'],'expected_thinking':task['expected_thinking'],
             'expected_tool_needed':bool(task['expected_calls']),'completion_tokens':0,'length_terminations':0}
        try:
            # All arms use the same d1 router so only reasoning treatment differs.
            r,m,p=self.api.decision(task['prompt'],task['media']['kind'] if task['media'] else None)
            self.request_record(ctx,'decision','decision',p,r,m); d=choose(r,self.o)
            row.update(decision=d,classifier_s=m['latency_s'],decision_input_truncated=len(task['prompt'])>self.o.decision_max_chars,
                       route_correct=d['route']==task['expected_route'],
