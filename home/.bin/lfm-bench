def read_text(path, default=''):
    try: return Path(path).read_text().strip()
    except (OSError, ValueError): return default


def read_int(path):
    try: return int(read_text(path))
    except ValueError: return None


def gpu_device():
    for card in sorted(Path('/sys/class/drm').glob('card[0-9]*')):
        dev = card / 'device'
        if read_text(dev/'vendor') == '0x1002' and (dev/'gpu_busy_percent').exists():
            return dev
    return None


def psi_avg10(resource):
    text = read_text('/proc/pressure/' + resource)
    try: return float(re.search(r'^some\s+avg10=([0-9.]+)', text, re.M).group(1))
    except (ValueError, AttributeError): return None


def meminfo():
    result = {}
    for line in read_text('/proc/meminfo').splitlines():
        m = re.match(r'^(\w+):\s+(\d+) kB$', line)
        if m: result[m.group(1)] = int(m.group(2)) * 1024
    return result


def cpu_counters():
    line = read_text('/proc/stat').splitlines()[0].split()
    values = [int(v) for v in line[1:]]
    total, idle = sum(values), values[3] + values[4]
    return total, idle


def process_rss(pid):
    status = read_text(f'/proc/{pid}/status')
    m = re.search(r'^VmRSS:\s+(\d+) kB$', status, re.M)
    return int(m.group(1)) / 1024 if m else 0.0


def percentile(seq, q):
    seq = sorted(x for x in seq if x is not None)
    if not seq: return None
    index = (len(seq)-1)*q/100
    low, high = math.floor(index), math.ceil(index)
    return seq[low] * (high-index) + seq[high]*(index-low) if low != high else seq[low]


def stats(values):
    seq = [x for x in values if isinstance(x, (float,int)) and math.isfinite(x)]
    return {'mean': statistics.mean(seq) if seq else None,
            'median': statistics.median(seq) if seq else None,
            'p95': percentile(seq, 95), 'max': max(seq) if seq else None}


def nicefmt(x, digits=1):
    return '-' if x is None else f'{x:.{digits}f}'


class Monitor:
    def __init__(self, path, interval=.20):
        self.path = path
        self.interval = interval
        self.gpu = gpu_device()
        self.records = []
        self.current_config = 'baseline'
        self.current_trial = 'idle'
        self.stop = threading.Event()
        self.lock = threading.Lock()
        self.thread = threading.Thread(target=self.loop, daemon=True)
        self.previous_cpu = None

    def start(self): self.thread.start()
    def close(self):
        self.stop.set()
        self.thread.join(timeout=3)

    def loop(self):
        planned = time.monotonic()
        with self.path.open('w') as fd:
            while not self.stop.is_set():
                now = time.monotonic()
                drift = max(0, (now - planned)*1000)
                planned = now+self.interval
                mem = meminfo()
                total, idle = cpu_counters()
                util = None
                if self.previous_cpu:
                    dtot = total - self.previous_cpu[0]
                    didle = idle - self.previous_cpu[1]
                    if dtot > 0: util = 100*(1-didle/dtot)
                self.previous_cpu = (total,idle)
                dev = self.gpu
                get = (lambda p: read_int(dev/p)) if dev else (lambda p: None)
                with self.lock:
                    key = self.current_config
                    trial = self.current_trial
                pids = [p.pid for p in CURRENT_PROCESSES if p.poll() is None]
                rec = {
                    'at': dt.datetime.now().isoformat(timespec='milliseconds'),
                    't': now, 'config': key, 'trial': trial, 'scheduler_lag_ms': round(drift, 3),
                    'cpu_percent': util, 'cpu_psi_avg10': psi_avg10('cpu'),
                    'mem_psi_avg10': psi_avg10('memory'),
                    'ram_available_mib': mem.get('MemAvailable',0)/MIB,
                    'ram_used_mib': (mem.get('MemTotal',0)-mem.get('MemAvailable',0))/MIB,
                    'swap_used_mib': (mem.get('SwapTotal',0)-mem.get('SwapFree',0))/MIB,
                    'gpu_busy_pct': get('gpu_busy_percent'),
                    'gpu_mem_busy_pct': get('mem_busy_percent'),
                    'vram_used_mib': (get('mem_info_vram_used') or 0)/MIB if dev and get('mem_info_vram_used') is not None else None,
                    'vram_total_mib': (get('mem_info_vram_total') or 0)/MIB if dev and get('mem_info_vram_total') is not None else None,
                    'gtt_used_mib': (get('mem_info_gtt_used') or 0)/MIB if dev and get('mem_info_gtt_used') is not None else None,
                    'servers_rss_mib': sum(process_rss(p) for p in pids),
                    'loadavg_1m': os.getloadavg()[0],
                    'server_pids': pids,
                }
                self.records.append(rec)
                fd.write(json.dumps(rec, separators=(',',':'))+'\n')
                fd.flush()
                self.stop.wait(self.interval)

    def mark(self, config=None, trial=None):
        with self.lock:
            if config is not None: self.current_config = config
            if trial is not None: self.current_trial = trial

    def range(self, start, stop):
        return [r for r in self.records if start <= r['t'] <= stop]

    def health(self):
        if not self.records: return (True, None)
        last = self.records[-1]
        if last['ram_available_mib'] < 1400: return (False, 'MemAvailable below 1.4 GiB')
        if last['mem_psi_avg10'] is not None and last['mem_psi_avg10'] > 50:
            return (False, 'memory PSI avg10 above 50%')
        return (True,None)

    def aggregate(self, start, stop):
        subset = self.range(start,stop)
        if not subset: return {}
        maximum = lambda key: max((x[key] for x in subset if x.get(key) is not None), default=None)
        minimum = lambda key: min((x[key] for x in subset if x.get(key) is not None), default=None)
        mean = lambda key: stats([x.get(key) for x in subset])['mean']
        return {
            'peak_cpu_percent': maximum('cpu_percent'),
            'mean_cpu_percent': mean('cpu_percent'),
            'peak_gpu_busy_pct': maximum('gpu_busy_pct'),
            'mean_gpu_busy_pct': mean('gpu_busy_pct'),
            'peak_gpu_mem_busy_pct': maximum('gpu_mem_busy_pct'),
            'peak_vram_mib': maximum('vram_used_mib'),
            'peak_gtt_mib': maximum('gtt_used_mib'),
            'peak_ram_used_mib': maximum('ram_used_mib'),
            'min_ram_available_mib': minimum('ram_available_mib'),
            'peak_swap_used_mib': maximum('swap_used_mib'),
            'peak_servers_rss_mib': maximum('servers_rss_mib'),
            'peak_cpu_psi_avg10': maximum('cpu_psi_avg10'),
            'peak_mem_psi_avg10': maximum('mem_psi_avg10'),
            'scheduler_lag_p95_ms': percentile([x['scheduler_lag_ms'] for x in subset],95),
            'scheduler_lag_max_ms': maximum('scheduler_lag_ms'),
            'peak_loadavg_1m': maximum('loadavg_1m'),
        }


CLIENT = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def http(port, path, data=None, timeout=80):
    payload = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(f'http://127.0.0.1:{port}{path}', data=payload,
                                 headers={'Content-Type':'application/json', 'Authorization':'Bearer local'})
    try:
        with CLIENT.open(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        body = e.read(700).decode(errors='replace')
        raise RuntimeError(f'HTTP {e.code}: {body}') from e


def png_test_image():
    # Fixed synthetic image; no personal media is read or uploaded.
    width,height = 640,480
    # Three horizontal high-contrast bands test actual image/projector processing.
    cols = [(15,92,211), (237,201,34), (25,175,83)]
    img = bytearray()
    for y in range(height):
        rgb = cols[min(2, y * 3 // height)]
        img.extend(b'\x00' + bytes(rgb)*width)
    def chunk(tag, data):
        return struct.pack('>I',len(data))+tag+data+struct.pack('>I',zlib.crc32(tag+data)&0xffffffff)
    ihdr = struct.pack('>2I5B',width,height,8,2,0,0,0)
    image = b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', ihdr)+chunk(b'IDAT',zlib.compress(img,7))+chunk(b'IEND',b'')
    return 'data:image/png;base64,' + base64.b64encode(image).decode()


def prompt_payload(kind, previous=None, image_url=None, long=False, repeats=None):
    # The same synthetic prompt is used for every configuration.
    incident = ('Arch Linux workstation with AMD 4650U, 16 GB shared memory, Wayland, '
                'llama.cpp Vulkan inference. A three-model assistant routes requests with D1, '
                'uses LFM3 text for tool reasoning, and Omni for image interpretation. '
                'Diagnose latency, minimize bandwidth contention, protect desktop input, '
                'and do not invent measurements. ')
    prefix = (incident * (repeats if repeats is not None else (45 if long else 6))).strip()
    if kind == 'text':
        user = prefix + '\nGive four actionable ways to reduce first-token latency and memory contention.'
    elif kind == 'omni':
        user = 'Inspect the attached synthetic RGB image. Which color occupies the middle band? '
        user += 'Then explain what makes image-prefill distinct from text-only prefill.'
        if previous: user += '\nHandoff note: '+previous[:800]
    else:
        user = prefix + '\nCombine both specialists into a concise recommendation. '
        if previous: user += '\nPrior handoff: '+previous[:1000]
    if image_url and kind == 'omni':
        content = [{'type':'text','text':user},{'type':'image_url','image_url':{'url':image_url}}]
    else:
        content = user
    return {'model':ALIASES['omni' if kind=='omni' else 'text'], 'messages':[
            {'role':'system','content':'You are a concise Linux specialist. Answer accurately and briefly.'},
            {'role':'user','content':content}],
            'max_tokens':64 if kind=='omni' else 80,
            'temperature':0, 'stream':False, 'cache_prompt':False, 'seed':42}


