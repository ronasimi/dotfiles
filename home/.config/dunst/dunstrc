# See dunst(5) for all configuration options

[global]
    ### Display ###
    monitor = 0
    follow = mouse

    ### Geometry ###
    width = (0,300)
    height = (0,1008)
    origin = top-right
    offset = (9,9)
    scale = 1
    notification_limit = 0

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 12
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = yes

    ### Appearance ###
    transparency = 65
    separator_height = 0
    gap_size = 9
    padding = 18
    horizontal_padding = 18
    text_icon_padding = 0
    frame_width = 1
    frame_color = "#1d1d1d"
    separator_color = frame
    sort = yes

    ### Text ###
    font = SF Pro 10.5
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icons ###
    icon_position = off
    min_icon_size = 0
    max_icon_size = 32
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

    ### History & Misc ###
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 9
    ignore_dbusclose = false

    ### Wayland & X11 ###
    force_xwayland = false
    force_xinerama = false

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = do_action, close_current

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#1d1d1d73"
    foreground = "#c3c3c3"
    timeout = 10

[urgency_normal]
    background = "#1d1d1d73"
    foreground = "#8ab4f8"
    timeout = 10

[urgency_critical]
    background = "#1d1d1d73"
    foreground = "#f4bf75"
    timeout = 15

[volume-history-ignore]
appname = volIndicator
history_ignore = yes

[brightness-history-ignore]
appname = brightIndicator
history_ignore = yes

[battery-history-ignore]
appname = clickBat
history_ignore = yes

[ethernet-history-ignore]
appname = clickEth
history_ignore = yes

[wifi-history-ignore]
appname = clickWifi
history_ignore = yes

[google-chrome]
appname = "Google Chrome"
urgency = normal
override_dbus_timeout = 10
background = "#1d1d1d73"
foreground = "#8ab4f8"

# vim: ft=cfg