[Unit]
Description=Hyprland Initial Login Lock
Documentation=man:hyprlock(1)
PartOf=graphical-session.target
After=graphical-session-pre.target
# Strictly order this to launch BEFORE your other graphical services
Before=waybar.service hypridle.service hyprpaper.service

[Service]
Type=simple
# %h is systemd's built-in variable for $HOME
ExecStart=/usr/bin/uwsm app -- %h/.bin/hyprlogin.sh
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
