[Unit]
Description=llama.cpp Vulkan Multi-Model Server
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/llama-server \
  --host 127.0.0.1 \
  --port 8080 \
  --models-preset %h/.config/llama.cpp/models.ini \
  --models-max 1 \
  --models-autoload

Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
