# Maximum and minimum number of peers to connect to per torrent.
min_peers = 1
max_peers = 400

# Same as above but for seeding completed torrents (-1 = same as downloading)
min_peers_seed = 10
max_peers_seed = 50

# Maximum number of simultaneous downloads
max_downloads_global = 3
# Maximum number of simultaneous uploads
max_uploads_global = 3

# Global upload and download rate in KiB. "0" for unlimited.
download_rate = 0
upload_rate = 500

# Default directory to save the downloaded torrents.
directory = /home/ron/Downloads/torrents

# Default session directory.
session = /home/ron/.rtsession

# --- Logging ---
log.open_file = "rtorrent", /home/ron/.rtsession/rtorrent.log
log.open_file = "tracker", /home/ron/.rtsession/tracker.log
log.open_file = "storage", /home/ron/.rtsession/storage.log

log.add_output = "info", "rtorrent"
log.add_output = "critical", "rtorrent"
log.add_output = "error", "rtorrent"
log.add_output = "warn", "rtorrent"
log.add_output = "notice", "rtorrent"
log.add_output = "debug", "rtorrent"
log.add_output = "storage_debug", "storage"

# --- Scheduling ---
schedule = watch_directory,5,5,load.start=/home/ron/Downloads/*.torrent
schedule = untied_directory,5,5,stop_untied=
schedule = tied_directory,5,5,start_tied=
schedule = low_diskspace,5,60,close_low_diskspace=100M

# Check hash for finished torrents
check_hash = yes

# --- Network & Protocol ---
# These must be defined as separate keys to satisfy the strict parser
protocol.encryption.set = handshake_prefer, stream_prefer

network.listen.port.set = 6900
dht.override_port.set = 6901
protocol.pex.set = yes

# --- Speed Optimizations ---
network.max_open_sockets.set = 999
network.max_open_files.set = 600
pieces.memory.max.set = 2048M
trackers.use_udp.set = yes

# --- UI Colors ---
ui.color.title.set = "bold black on bright white"
ui.color.footer.set = "bold black on white"
ui.color.focus.set = "reverse"
ui.color.label.set = ""
ui.color.complete.set = "green"
ui.color.seeding.set = "blue"
ui.color.stopped.set = "red"
ui.color.queued.set = "dim yellow"
ui.color.leeching.set = "bright yellow"
ui.color.incomplete.set = "bright red"
ui.color.odd.set = "bold"
ui.color.even.set = ""

# --- Notifications ---
method.set_key = event.download.finished,notify_me,"execute={notify-send,-u,normal,-a,rTorrent,Torrent Finished,$d.name=}"
